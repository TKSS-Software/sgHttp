import "pkg:/source/roku_modules/promises/promises.brs"
import "pkg:/source/keys.bs"

sub init()
    m.requests = []
    m.queued = []
    m.top.observeField("cancel", "onCancel")
end sub

' Marks request index as sent, so a cancel that only drops queued requests leaves it
function markSent(index as integer) as boolean
    request = m.requests[index]
    if request = invalid then return false
    request.sent = true
    return true
end function

sub onCancel()
    ' A transport that cannot abort a request in flight: the cancel is taken, the answer still comes
    if m.top.noAbort then return
    data = m.top.cancel
    if type(data) <> "roAssociativeArray" then return
    for each request in m.requests
        if request.promise.id = data.id then
            if request.settled = true or (data.queuedOnly = true and request.sent = true) then return
            request.settled = true
            promises.reject({ code: 0, cancelled: true, message: "sghttp: cancelled" }, request.promise)
            return
        end if
    end for
end sub

' The store's request: kept, unanswered, until answer or fail, unless answerNext queued a body
function makeRequest(spec as object) as object
    pending = promises.create()
    m.requests.push({ spec: spec, promise: pending, sent: false, settled: false })
    m.top.requestCount = m.requests.count()
    if m.queued.count() > 0 then
        queued = m.queued.shift()
        answerWith(m.requests.count() - 1, queued.body, queued.headers)
    end if
    return pending
end function

' Answers the next request not yet made with this body and these response headers
function answerNextWith(body as string, headers as object) as boolean
    m.queued.push({ body: body, headers: headers })
    return true
end function

' Answers request index with a 200, this body (its own hash) and these response headers
function answerWith(index as integer, body as string, headers as object) as boolean
    request = m.requests[index]
    if request = invalid then return false
    request.settled = true
    promises.resolve({ code: 200, body: body, bodyHash: body, headers: headers, url: "", ms: 0 }, request.promise)
    return true
end function

' The id of the promise returned for request index, which a promotion names
function promiseIdAt(index as integer) as dynamic
    request = m.requests[index]
    if request = invalid then return invalid
    return request.promise.id
end function

' Answers the next request not yet made with this body, for requests that start later
' (after a disk read)
function answerNext(body as string) as boolean
    return answerNextWith(body, {})
end function

' Answers request index (0 = the first made) with a 200 and this body. The body is its own
' hash, so the same body counts as unchanged.
function answer(index as integer, body as string) as boolean
    request = m.requests[index]
    if request = invalid then return false
    promises.resolve({ code: 200, body: body, bodyHash: body, headers: {}, url: "", ms: 0 }, request.promise)
    return true
end function

' Answers request index with a 200 and a decoded (JSON) body, hashed by its JSON
function answerBody(index as integer, body as object) as boolean
    request = m.requests[index]
    if request = invalid then return false
    request.settled = true
    promises.resolve({ code: 200, body: body, bodyHash: formatJson(body), headers: {}, url: "", ms: 0 }, request.promise)
    return true
end function

' Answers request index as a transport does when the body hashes to the spec's knownHash: a 200
' with no body. false when the request sent no knownHash.
function answerUnchanged(index as integer) as boolean
    request = m.requests[index]
    if request = invalid or not isNonEmptyString(request.spec.knownHash) then return false
    request.settled = true
    promises.resolve({ code: 200, body: invalid, bodyHash: request.spec.knownHash, unchanged: true, headers: {}, url: "", ms: 0 }, request.promise)
    return true
end function

function fail(index as integer, code = 0 as integer) as boolean
    request = m.requests[index]
    if request = invalid then return false
    request.settled = true
    promises.reject({ message: "fake failure", code: code }, request.promise)
    return true
end function

' The spec of request index, e.g. to check its url
function requestAt(index as integer) as dynamic
    request = m.requests[index]
    if request = invalid then return invalid
    return request.spec
end function
