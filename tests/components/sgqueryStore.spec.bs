        end function
        @async
        @it("runs the body through a named parser on the parser task")
        function _()
            m.dropStore()
            m.fake = createObject("roSGNode", "FakeTransport")
            m.store = createObject("roSGNode", "Store")
            m.store.callFunc("_initialize", { transport: m.fake, persist: false, parserTask: "SpecParserTask" })
            waiting = m.store.callFunc("_fetch", { url: "/word", parser: "Upper" }, { tag: "t" })
            m.fake.callFunc("answer", 0, "abc")
            promises.chain(waiting, m).then(function(response as object, suite as object) as dynamic
                suite.assertEqual(response.code, 200)
                suite.assertEqual(response.body, "ABC|t")
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @async
        @it("rejects a spec naming a parser when no parser task was configured")
        function _()
            m.makeStore()
            waiting = m.store.callFunc("_fetch", { url: "/word", parser: "Upper" }, {})
            m.fake.callFunc("answer", 0, "abc")
            promises.chain(waiting, m).then(function(response as object, suite as object) as dynamic
                suite.fail("resolved without a parser task")
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.assertTrue(error.message.instr("parserTask") >= 0)
                suite.done()
                return invalid
            end function)
        end function

        ' A store with the spec parser task; persisting (to the shared disk, as the app "parser
        ' app") when persist is true
        function makeParsingStore(persist = false as boolean)
            m.dropStore()
            m.fake = createObject("roSGNode", "FakeTransport")
            m.store = createObject("roSGNode", "Store")
            m.store.callFunc("_initialize", { transport: m.fake, persistence: m.disk(), persist: persist, parserTask: "SpecParserTask", version: "spec", appInfo: { id: "dev", title: "parser app", version: "1" } })
            m.store.callFunc("_define", "words", { request: { url: "/words/{id}" }, parser: "Field", ttl: 300, persist: true })
        end function

        @async
        @it("hands the parser the body decoded on its own task")
        function _()
            m.makeParsingStore()
            waiting = m.store.callFunc("_fetch", { url: "/word", parser: "Field" }, {})
            m.fake.callFunc("answer", 0, `{"word":"abc"}`)
            promises.chain(waiting, m).then(function(response as object, suite as object) as dynamic
                suite.assertEqual(response.body, "abc")
                ' The transport was asked for the text, not a decoded body
                suite.assertFalse(suite.fake.callFunc("requestAt", 0).parseJson)
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @async
        @it("hands the parser the text when the request has parseJson false")
        function _()
            m.makeParsingStore()
            waiting = m.store.callFunc("_fetch", { url: "/word", parser: "Field", parseJson: false }, {})
            m.fake.callFunc("answer", 0, `{"word":"abc"}`)
            promises.chain(waiting, m).then(function(response as object, suite as object) as dynamic
                suite.assertEqual(response.body, `text:{"word":"abc"}`)
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @async
        @it("keeps a parsed body on disk as its text and parses it again after a restart")
        function _()
            m.makeParsingStore(true)
            m.store.callFunc("_invalidate", invalid, invalid)
            m.fake.callFunc("answerNext", `{"word":"abc"}`)
            promises.chain(m.store.callFunc("_query", "words", { id: "1" }, {}), m).then(function(value as dynamic, suite as object) as dynamic
                suite.assertEqual(value, "abc")
                ' A new store for the same app reads the body back from the shared disk task,
                ' queued behind the write
                suite.makeParsingStore(true)
                return suite.store.callFunc("_query", "words", { id: "1" }, {})
            end function).then(function(value as dynamic, suite as object) as dynamic
                suite.assertEqual(value, "abc")
                suite.assertEqual(suite.fake.requestCount, 0)
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @async
        @it("parses a small body on a second parser task while a slow parse runs")
        function _()
            m.makeParsingStore()
            m.slow = m.store.callFunc("_fetch", { url: "/slow", parser: "Slow" }, {})
            fast = m.store.callFunc("_fetch", { url: "/word", parser: "Field" }, {})
            m.fake.callFunc("answer", 0, "x")
            m.fake.callFunc("answer", 1, `{"word":"abc"}`)
            promises.chain(fast, m).then(function(response as object, suite as object) as dynamic
                suite.assertEqual(response.body, "abc")
                suite.assertFalse(promises.isComplete(suite.slow))
                return suite.slow
            end function).then(function(response as object, suite as object) as dynamic
                suite.assertEqual(response.body, "slow")
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function
        @describe("pages")

        ' "list" pages by a cursor the body carries in next; later pages have their own request
        function makePagedStore()
            m.makeStore()
            m.store.callFunc("_define", "list", { request: { url: "/list" }, ttl: 300, pages: { next: "next", arg: "cursor", request: { url: "/list?after={cursor}" } } })
        end function

        @async
        @it("loads a page at a time and resolves with every page so far")
        function _()
            m.makePagedStore()
            first = m.store.callFunc("_query", "list", {}, {})
            m.assertEqual(m.fake.callFunc("requestAt", 0).url, "/list")
            m.fake.callFunc("answerBody", 0, { items: ["a"], next: "c2" })
            promises.chain(first, m).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 1)
                suite.assertEqual(result.pages[0].items[0], "a")
                suite.assertTrue(result.hasNext)
                more = suite.store.callFunc("_nextPage", "list", {})
                suite.assertEqual(suite.fake.callFunc("requestAt", 1).url, "/list?after=c2")
                suite.fake.callFunc("answerBody", 1, { items: ["b"], next: "" })
                return more
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 2)
                suite.assertEqual(result.pages[1].items[0], "b")
                suite.assertFalse(result.hasNext)
                ' On the last page nothing is loaded and nothing is sent
                return suite.store.callFunc("_nextPage", "list", {})
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(suite.fake.requestCount, 2)
                suite.assertEqual(result.pages.count(), 2)
                ' peek and query answer with the pages too, from memory
                suite.assertEqual(suite.store.callFunc("_peek", "list", {}).pages.count(), 2)
                return suite.store.callFunc("_query", "list", {}, {})
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 2)
                suite.assertEqual(suite.fake.requestCount, 2)
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @async
        @it("loads the first page when nothing is loaded, and shares a next page already loading")
        function _()
            m.makePagedStore()
            first = m.store.callFunc("_nextPage", "list", {})
            m.assertEqual(m.fake.callFunc("requestAt", 0).url, "/list")
            m.fake.callFunc("answerBody", 0, { items: ["a"], next: "c2" })
            promises.chain(first, m).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 1)
                one = suite.store.callFunc("_nextPage", "list", {})
                two = suite.store.callFunc("_nextPage", "list", {})
                suite.assertTrue(one.isSameNode(two))
                suite.assertEqual(suite.fake.requestCount, 2)
                suite.fake.callFunc("answerBody", 1, { items: ["b"], next: "" })
                return one
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 2)
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @async
        @it("starts the pages over when a refresh finds a different first page, and tells the watcher")
        function _()
            m.makePagedStore()
            m.watchedOne = createObject("roSGNode", "Node")
            m.watchedOne.addField("changed", "assocarray", true)
            m.store.callFunc("_watch", "list", {}, m.watchedOne)
            first = m.store.callFunc("_query", "list", {}, {})
            m.fake.callFunc("answerBody", 0, { items: ["a"], next: "c2" })
            promises.chain(first, m).then(function(result as object, suite as object) as dynamic
                more = suite.store.callFunc("_nextPage", "list", {})
                suite.fake.callFunc("answerBody", 1, { items: ["b"], next: "" })
                return more
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 2)
                suite.assertTrue(suite.heardNothing(suite.watchedOne))
                ' A revalidation finds the listing re-cut: the kept pages answer now, the check runs behind
                suite.store.callFunc("_query", "list", {}, { revalidate: true })
                ' A plain query answers from memory while the check runs; force joins the check
                inFlight = suite.store.callFunc("_query", "list", {}, { force: true })
                suite.assertEqual(suite.fake.requestCount, 3)
                suite.fake.callFunc("answerBody", 2, { items: ["z"], next: "c9" })
                return inFlight
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 1)
                suite.assertEqual(result.pages[0].items[0], "z")
                changed = suite.watchedOne.changed
                suite.assertEqual(changed.value.pages.count(), 1)
                suite.assertTrue(changed.value.hasNext)
                ' The next page follows the new listing
                suite.store.callFunc("_nextPage", "list", {})
                suite.assertEqual(suite.fake.callFunc("requestAt", 3).url, "/list?after=c9")
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @async
        @it("drops and expires the later pages with the first")
        function _()
            m.makePagedStore()
            first = m.store.callFunc("_query", "list", {}, {})
            m.fake.callFunc("answerBody", 0, { items: ["a"], next: "c2" })
            promises.chain(first, m).then(function(result as object, suite as object) as dynamic
                more = suite.store.callFunc("_nextPage", "list", {})
                suite.fake.callFunc("answerBody", 1, { items: ["b"], next: "" })
                return more
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(suite.store.callFunc("_getStats").entries, 2)
                ' Expired by args: a plain query of the first page waits for the server again
                suite.store.callFunc("_expire", "list", {})
                waiting = suite.store.callFunc("_query", "list", {}, {})
                suite.assertEqual(suite.fake.requestCount, 3)
                suite.fake.callFunc("answerBody", 2, { items: ["a"], next: "c2" })
                return waiting
            end function).then(function(result as object, suite as object) as dynamic
                ' Unchanged first page: the pages after it are kept
                suite.assertEqual(result.pages.count(), 2)
                suite.store.callFunc("_invalidate", "list", {})
                suite.assertEqual(suite.store.callFunc("_getStats").entries, 0)
                suite.assertInvalid(suite.store.callFunc("_peek", "list", {}))
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function
        @async
        @it("reads an expired later page again when the listing is paged by position")
        function _()
            m.makeStore()
            m.store.callFunc("_define", "list", { request: { url: "/list" }, ttl: 300, pages: { next: "next", arg: "cursor", request: { url: "/list?after={cursor}" }, byPosition: true } })
            first = m.store.callFunc("_query", "list", {}, {})
            m.fake.callFunc("answerBody", 0, { items: ["a"], next: "c2" })
            promises.chain(first, m).then(function(result as object, suite as object) as dynamic
                more = suite.store.callFunc("_nextPage", "list", {})
                suite.fake.callFunc("answerBody", 1, { items: ["b"], next: "" })
                return more
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 2)
                ' A write lands at the front: the first page now points to the same next page,
                ' whose content has moved on
                suite.store.callFunc("_expire", "list", {})
                waiting = suite.store.callFunc("_query", "list", {}, {})
                suite.fake.callFunc("answerBody", 2, { items: ["new"], next: "c2" })
                return waiting
            end function).then(function(result as object, suite as object) as dynamic
                ' The old second page is not kept: the listing ends at the first, with more to read
                suite.assertEqual(result.pages.count(), 1)
                suite.assertEqual(result.pages[0].items[0], "new")
                suite.assertTrue(result.hasNext)
                more = suite.store.callFunc("_nextPage", "list", {})
                suite.assertEqual(suite.fake.requestCount, 4)
                suite.assertEqual(suite.fake.callFunc("requestAt", 3).url, "/list?after=c2")
                suite.fake.callFunc("answerBody", 3, { items: ["a"], next: "c3" })
                return more
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 2)
                suite.assertEqual(result.pages[1].items[0], "a")
                suite.assertTrue(result.hasNext)
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @async
        @it("keeps the later pages when a changed first page still points to the same next page")
        function _()
            m.makePagedStore()
            m.watchedOne = createObject("roSGNode", "Node")
            m.watchedOne.addField("changed", "assocarray", true)
            m.store.callFunc("_watch", "list", {}, m.watchedOne)
            first = m.store.callFunc("_query", "list", {}, {})
            m.fake.callFunc("answerBody", 0, { items: ["a"], next: "c2" })
            promises.chain(first, m).then(function(result as object, suite as object) as dynamic
                more = suite.store.callFunc("_nextPage", "list", {})
                suite.fake.callFunc("answerBody", 1, { items: ["b"], next: "" })
                return more
            end function).then(function(result as object, suite as object) as dynamic
                suite.store.callFunc("_query", "list", {}, { revalidate: true })
                ' A plain query answers from memory while the check runs; force joins the check
                inFlight = suite.store.callFunc("_query", "list", {}, { force: true })
                suite.fake.callFunc("answerBody", 2, { items: ["a2"], next: "c2" })
                return inFlight
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 2)
                suite.assertEqual(result.pages[0].items[0], "a2")
                suite.assertEqual(result.pages[1].items[0], "b")
                suite.assertEqual(suite.watchedOne.changed.value.pages.count(), 2)
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @async
        @it("loads the next page again after a load that failed")
        function _()
            m.makePagedStore()
            first = m.store.callFunc("_query", "list", {}, {})
            m.fake.callFunc("answerBody", 0, { items: ["a"], next: "c2" })
            promises.chain(first, m).then(function(result as object, suite as object) as dynamic
                more = suite.store.callFunc("_nextPage", "list", {})
                suite.fake.callFunc("fail", 1, 500)
                return more
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.assertEqual(error.code, 500)
                ' Not stuck on the failed load: a new request goes out
                again = suite.store.callFunc("_nextPage", "list", {})
                suite.assertEqual(suite.fake.requestCount, 3)
                suite.assertEqual(suite.fake.callFunc("requestAt", 2).url, "/list?after=c2")
                suite.fake.callFunc("answerBody", 2, { items: ["b"], next: "" })
                return again
            end function).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 2)
                suite.assertEqual(result.pages[1].items[0], "b")
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @describe("precache")

        @async
        @it("starts a query that a later query joins, and does nothing while one is in flight or fresh")
        function _()
            m.makeStore()
            m.assertTrue(m.store.callFunc("_precache", "items", { id: "1" }))
            m.assertFalse(m.store.callFunc("_precache", "items", { id: "1" }))
            m.assertFalse(m.store.callFunc("_precache", "nothing", {}))
            m.assertFalse(m.store.callFunc("_precache", "items.save", { id: "1" }))
            waiting = m.query("1")
            m.assertEqual(m.fake.requestCount, 1)
            m.fake.callFunc("answerBody", 0, { name: "one" })
            promises.chain(waiting, m).then(function(value as object, suite as object) as dynamic
                suite.assertEqual(value.name, "one")
                suite.assertFalse(suite.store.callFunc("_precache", "items", { id: "1" }))
                suite.assertEqual(suite.fake.requestCount, 1)
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function

        @async
        @it("loads the first page of a query with pages, which a later query answers with")
        function _()
            m.makePagedStore()
            m.assertTrue(m.store.callFunc("_precache", "list", {}))
            m.assertEqual(m.fake.callFunc("requestAt", 0).url, "/list")
            ' The query joins the precache's request, and answers with the pages
            waiting = m.store.callFunc("_query", "list", {}, {})
            m.assertEqual(m.fake.requestCount, 1)
            m.fake.callFunc("answerBody", 0, { items: ["a"], next: "c2" })
            promises.chain(waiting, m).then(function(result as object, suite as object) as dynamic
                suite.assertEqual(result.pages.count(), 1)
                suite.assertEqual(result.pages[0].items[0], "a")
                suite.assertTrue(result.hasNext)
                return suite.store.callFunc("_query", "list", {}, {})
            end function).then(function(result as object, suite as object) as dynamic
                ' From memory, in the same shape
                suite.assertEqual(result.pages.count(), 1)
                suite.assertEqual(suite.fake.requestCount, 1)
                suite.done()
                return invalid
            end function).catch(function(error as dynamic, suite as object) as dynamic
                suite.fail("rejected: " + formatJson(error))
                suite.done()
                return invalid
            end function)
        end function
    end class
end namespace
