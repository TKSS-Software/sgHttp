<?xml version="1.0" encoding="utf-8"?>
<!-- A transport for the store whose requests wait until a spec answers them, so a spec
     controls the order responses arrive in -->
<component name="FakeTransport" extends="Node">
    <interface>
        <!-- How many requests the store has made -->
        <field id="requestCount" type="integer" value="0" />
        <!-- The client's shared headers, as the store sets them -->
        <field id="headers" type="assocarray" />
        <!-- The last promotion the store asked for, { id, priority } -->
        <field id="promote" type="assocarray" />
        <!-- The store's cancels, { id, queuedOnly }: a request not yet answered (and, with
             queuedOnly, not marked sent) rejects as cancelled -->
        <field id="cancel" type="assocarray" alwaysNotify="true" />
        <!-- Set by a store's destroy when it owns the transport; a passed-in one stays false -->
        <field id="shutdown" type="boolean" value="false" />
        <!-- true: a cancel is taken but aborts nothing, as a transport that cannot abort a request in flight -->
        <field id="noAbort" type="boolean" value="false" />
        <function name="makeRequest" />
        <function name="answer" />
        <function name="answerBody" />
        <function name="answerUnchanged" />
        <function name="answerNext" />
        <function name="answerNextWith" />
        <function name="answerWith" />
        <function name="fail" />
        <function name="requestAt" />
        <function name="promiseIdAt" />
        <function name="markSent" />
    </interface>
</component>
