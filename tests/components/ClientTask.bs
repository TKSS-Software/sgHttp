import "pkg:/source/roku_modules/promises/promises.brs"
import "pkg:/source/client.bs"

sub init()
    m.top.functionName = "runTask"
end sub

' The loop the guide shows: the client on the task's port, promises routed to it, every message
' handed to the client until the scenario settles
sub runTask()
    port = createObject("roMessagePort")
    promises.setMessagePort(port)
    m.client = createHttpClient({ baseUrl: m.top.baseUrl, headers: { "X-Shared": "s" }, retries: 1 }, port)
    m.done = false
    scenario = m.top.scenario
    work = promises.reject({ message: "ClientTask: unknown scenario " + scenario })
    if scenario = "fill" then
        work = m.client.fetch({ url: "/echo", method: "POST", query: { q: "{term}", empty: "{missing}" }, headers: { "X-Id": "{id}" }, body: { slug: "{slug}" }, auth: false }, { term: "drama", id: "7", slug: "pilot" })
    else if scenario = "graphql" then
        work = m.client.fetch({ url: "/graphql-partial", graphql: { query: "query { a }" } })
    else if scenario = "retry" then
        work = m.client.fetch("/flaky/task-" + createObject("roDeviceInfo").getRandomUUID().left(8) + "/1")
    else if scenario = "cancel" then
        work = m.client.fetch("/slow/3000")
        m.client.cancel(work)
    else if scenario = "parser" then
        work = m.client.fetch({ url: "/echo", parser: "SomeParser" })
    else if scenario = "stream" then
        ' An event stream with a listener of the task's: closed from inside its third event
        work = promises.create()
        listener = { client: m.client, work: work, id: "", result: { opens: 0, messages: [], closed: invalid, closedAgain: true } }
        listener.onOpen = function(info as object)
            m.result.opens++
        end function
        listener.onMessage = function(message as object)
            m.result.messages.push(message)
            if m.result.messages.count() = 3 then
                m.client.closeEventStream(m.id)
                m.result.closedAgain = m.client.closeEventStream(m.id)
                promises.resolve(m.result, m.work)
            end if
        end function
        listener.onClosed = function(info as object)
            m.result.closed = info
        end function
        listener.id = m.client.openEventStream("/sse/fields", listener)
    end if
    promises.chain(promises.allSettled([work]), m).then(function(results as object, m as object) as dynamic
        m.done = true
        promises.resolve(results[0], m.top.promise)
        return invalid
    end function)
    while not m.done
        message = promises.wait2(m.client.nextWait(), port)
        m.client.handle(message)
    end while
end sub
