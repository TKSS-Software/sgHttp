import "pkg:/source/roku_modules/promises/promises.brs"
import "keys.bs"

'************************
'*** sghttp public API: an HTTP client (initialize, fetch, setHeaders) and, only if the app
'*** defines queries, a cache on top of it (define, query, mutate and the rest).
'*** Import this file in any component (not main.brs). After ropm install the
'*** functions are available as sghttp.initialize(), sghttp.fetch(), etc.
'*** All state lives in a single Store node attached to the scene, so every
'*** component shares one cache (the same shape as sgRouter's router node,
'*** though sgRouter is not required).
'************************

'*************************************************************************
'#region Shapes
' The objects the functions below take and return, for completion and hover in an editor.
' They are not enforced: any associative array with the right keys works.
'*************************************************************************

' A request: a definition's request, or fetch's spec. {name} placeholders in strings are
' filled from the args and the current scopes.
interface Request
    ' Relative to the client's baseUrl, or absolute (starting with http)
    url as string
    ' GET (default), HEAD, POST, PUT, PATCH, DELETE
    optional method as string
    ' Added to the client's shared headers for this request
    optional headers as object
    ' An associative array or array is sent as JSON; a string as text; "{name}" passes that arg through
    optional body as dynamic
    ' Query string parameters; a placeholder with nothing to fill it drops the parameter; an array repeats it
    optional query as object
    ' false leaves the response body as text. Default true
    optional parseJson as boolean
    ' Attempts after the first. Default: the transport's
    optional retries as integer
    ' A GraphQL operation, sent as JSON in a POST (see GraphQL)
    optional graphql as GraphQL
end interface

' A GraphQL operation. The query text is sent as it is, never filled from args; a variable whose
' value is exactly "{name}" takes that arg with its type (a number, an object), and other strings
' are filled as text. A query resolves with the response's data; a response with errors and no
' data rejects with them. A mutation (read from the query text) is never cached, and is retried
' and cancelled as a write.
interface GraphQL
    query as string
    optional variables as object
    optional operationName as string
end interface

' fetch's spec: a request plus the per-request settings a definition has
interface FetchSpec extends Request
    ' The client to send through. Default: the default client
    optional client as string
    ' false leaves out the client's shared headers
    optional auth as boolean
    ' false sends directly even when a debugging proxy is set
    optional proxy as boolean
    ' Seconds before the request is given up and retried
    optional timeout as integer
    ' Statuses treated as success. Default 200-299
    optional successCodes as object
    ' A parser name to run the body through on the parser task
    optional parser as string
    ' A name for the events this request emits. Default "fetch"
    optional name as string
    ' "high", "normal" or "low": where the request waits when the transport's pool is busy
    optional priority as string
    ' A path (tmp:/ or cachefs:/) to write a GET's body to; resolves with path, not body (see Downloading to a file)
    optional toFile as string
end interface

' The pages of a query loaded a page at a time (see define's pages)
interface Pages
    ' Path in a page's value to the cursor of the page after it; empty, missing or false on the last
    next as string
    ' The arg the cursor is passed as. Default "next"
    optional arg as string
    ' The request for pages after the first. Default: the definition's
    optional request as Request
    ' Path in a page's value to whether a page follows it (true), for an API whose last page
    ' still has a cursor, such as GraphQL's Relay pageInfo.hasNextPage. Optional
    optional hasNext as string
    ' The API cuts pages by position (page=2): a later page that has expired is read again by
    ' nextPage rather than kept, since a change shifts entries between pages. Default false
    optional byPosition as boolean
end interface

' What define takes (see define for each key's meaning and default)
interface Definition
    request as Request
    optional parser as string
    optional ttl as integer
    optional staleWhileRevalidate as boolean
    optional persist as boolean
    optional scopes as object
    optional bucket as integer
    optional successCodes as object
    optional cache as boolean
    optional removes as object
    optional expires as object
    optional client as string
    optional auth as boolean
    optional proxy as boolean
    optional timeout as integer
    optional conditional as boolean
    optional compare as string
    optional pages as Pages
    ' "high", "normal" or "low": where this query's requests wait when the transport's pool is
    ' busy. Default "normal". Background refreshes and precaches queue low whatever this says.
    optional priority as string
end interface

' A server's settings: initialize's top level for the default client, or one of clients
interface ClientSettings
    optional baseUrl as string
    optional headers as object
    optional baseHeaders as object
    optional proxy as string
    optional maxConcurrent as integer
    optional timeout as integer
    optional retries as integer
    optional httpVersion as string
    optional transport as object
end interface

' What initialize takes (see initialize for each key's meaning and default)
interface InitializeParams extends ClientSettings
    optional parserTask as string
    optional parserThreads as integer
    optional persist as boolean
    optional version as string
    optional namespace as string
    optional maxEntries as integer
    optional defaultTtl as integer
    ' { <name>: ClientSettings }
    optional clients as object
    optional debug as boolean
    optional store as object
    optional persistence as object
    ' { id, title, version } to name the disk namespace with instead of roAppInfo (tests)
    optional appInfo as object
end interface

' What fetch resolves with, and what a failing status or network error rejects with
interface Response
    ' The HTTP status; negative for a network failure
    code as integer
    headers as object
    ' JSON-decoded, the raw text, or the parser's result
    body as dynamic
    url as string
    ' Milliseconds from sending to the answer
    ms as integer
    ' On a failure
    optional message as string
    ' A network failure or cancel: offline | timeout | dns | tls | connection | network | cancelled
    optional kind as string
    ' A cancelled call
    optional cancelled as boolean
    ' A GraphQL response's errors, alongside partial data or on failure
    optional errors as object
    ' fetch with toFile: where the body was written
    optional path as string
end interface

' What query, nextPage and peek answer with for a query defined with pages
interface PagedValue
    ' Each page's value, in order
    pages as object
    ' Whether the last page points to another
    hasNext as boolean
end interface

interface QueryOptions
    ' Skip the memory and disk copies and wait for a request
    optional force as boolean
    ' Resolve with the cached value at once and check the server in the background
    optional revalidate as boolean
    ' "high", "normal" or "low" for this call's request, over the definition's priority. A
    ' request already queued lower that this call joins is raised to it.
    optional priority as string
end interface

' A value written before a mutation's request, and put back if it fails
interface OptimisticWrite
    name as string
    optional args as object
    value as dynamic
end interface

interface MutateOptions
    ' [OptimisticWrite]
    optional optimistic as object
end interface

interface ScopeOptions
    ' true keeps the previous value's entries instead of dropping them
    optional keep as boolean
end interface

' An event, from observeEvents (the store's lastEvent)
interface Event
    ' hit | stale | dedupe | resolve | unchanged | set | error | cancel
    type as string
    name as string
    key as string
    ' memory | disk | network | local
    source as string
    ms as integer
    client as string
    ' Errors only: the HTTP status, or 0
    optional code as integer
    ' Errors only: whether the request sent the client's shared headers
    optional auth as boolean
end interface

' A change, from watch (with value) and observeChanges (without)
interface Change
    name as string
    key as string
    source as string
    optional value as dynamic
end interface

'#endregion

' Creates the Store singleton on the scene and returns it. Idempotent: a second
' call returns the existing store.
' @param {Object} params
'   The top-level baseUrl, proxy, headers, baseHeaders, transport, maxConcurrent, timeout,
'   retries and httpVersion configure the default client: the server every definition
'   without a client talks to. An app with one server needs nothing else.
'   transport   - node exposing makeRequest(spec) that returns a promise node. Default: a Transport task.
'   parserTask  - component name of a Task extending ParserTask that implements getParser(name). Optional.
'   parserThreads - how many of parserTask to run, each parse going to the least busy. Default 2.
'   baseUrl     - prefix for relative request urls. Optional.
'   proxy       - debugging proxy as "host:port" (e.g. Charles); every request url to a public host becomes
'                 http://host:port/;<url>. Empty or missing disables it. Optional.
'   headers     - associative array of headers sent with every request (e.g. Authorization). Optional.
'   baseHeaders - headers sent with every request without exception, even where auth is false. Optional.
'   persist     - enable cachefs:/ persistence for definitions that opt in. Default true.
'   version     - cache version string; bump to stop every body on disk from being read. Rarely needed:
'                 the app version (namespace), the server (baseUrl) and the definition already keep
'                 bodies apart. Default "1".
'   namespace   - this app's folder under cachefs:/sghttp/. Default: <channel id>_<title>-<hash>_<app version>
'                 from roAppInfo, so sideloaded apps (all "dev") never share bodies, and each release
'                 starts empty (the same app's other versions' folders are deleted). Optional.
'   maxEntries  - in-memory entry cap, least recently used evicted first (the disk copy stays). Default 100.
'   defaultTtl  - seconds; used by definitions without a ttl. Default 300.
'   maxConcurrent, timeout, retries, httpVersion - the default client's Transport settings. Optional.
'   clients     - more servers: { <name>: { baseUrl, headers, baseHeaders, proxy, maxConcurrent,
'                 timeout, retries, httpVersion, transport } }, each with its own transport and
'                 shared headers, inheriting nothing from the default client. A definition picks
'                 one with client: "<name>". Optional.
'   debug       - true prints every event and change to the console with its cache key, as
'                 "[sghttp] <type> <name> via <source> (<ms>ms) <key>". Default false.
'   store       - an existing Store node (tests). Optional.
'   persistence - an existing Persistence node to run file operations on (tests). Optional.
function initialize(params = {} as InitializeParams) as object
    scene = m.top.getScene()
    existing = scene.__sghttp
    if isNode(existing) then return existing
    store = params.store
    if not isNode(store) then store = createObject("roSGNode", "Store")
    scene.addFields({ __sghttp: store })
    store.callFunc("_initialize", params)
    return store
end function

' Returns the Store node, or invalid if initialize() has not run.
function getStore() as object
    return m.top.getScene().__sghttp
end function

' Registers a query definition.
' @param {String} name - unique query name, also the first segment of every cache key
' @param {Object} definition
'   request  - { url, method, headers, body, query, parseJson } with {arg} placeholders filled from args and scopes,
'              or { url, graphql: { query, variables, operationName } } for a GraphQL operation (see GraphQL)
'   parser   - parser name resolved by the parser task's getParser(name); runs off the render thread. Optional.
'   ttl      - seconds a resolved value is fresh. Omitted: initialize's defaultTtl (300).
'              Negative: fresh until expired or removed.
'   staleWhileRevalidate - when true, a stale value is returned immediately and refetched in the background. Default true.
'   persist  - write the raw response to cachefs:/ and serve it on cold start. Default false.
'   scopes   - array of scope names (see setScope) that become part of the key, e.g. ["profile"].
'   bucket   - seconds; floor(now / bucket) joins the key so time-sensitive data rolls over. Optional.
'   successCodes - array of HTTP codes treated as success. Default 200-299.
'   cache    - false for mutations and per-call resources (stream urls): runs the request, never stores. Default true.
'   removes  - array of query names (the query and its dotted descendants) removed after a cache: false request succeeds.
'   expires  - array of query names (the query and its dotted descendants) expired (see expire) after a cache: false request
'              succeeds, and refreshed where watched (see refresh): the usual choice for a mutation,
'              since the old value stays available and the screens showing it get the server's word.
'   client   - the name of a client from initialize({ clients }) this query talks to. Default: the
'              default client (initialize's top-level settings). Query names are shared by all
'              clients: give another server's queries its name as a prefix ("partner.homePage").
'   auth     - false to omit the client's shared headers (auth) from this query. Default true.
'   proxy    - false to send the request directly even when a debugging proxy is set. Default true.
'   timeout  - seconds before a request with no answer is given up (and retried); default the
'              transport's (30). Short for endpoints that can stall, so a retry comes sooner.
'   conditional - true to send the last response's ETag / Last-Modified back (If-None-Match /
'              If-Modified-Since); a 304 renews the cached value. Default false.
'   compare  - "parsed" also compares the parsed value (MD5 of its JSON, computed in the
'              parser task) when the body differs: the same parsed value renews the entry
'              without a change notification. For responses with volatile fields the parser
'              drops. Default "body".
'   pages    - { next, arg, request, hasNext, byPosition } makes this a query with pages: next is the path in a page's value
'              to the cursor of the page after it (empty or missing on the last page, unless hasNext,
'              a path to whether a page follows, says so instead: Relay's pageInfo.hasNextPage), arg the arg
'              that cursor is passed as (default "next"), request the request for pages after the
'              first (default: request). query and nextPage then resolve with { pages, hasNext }.
'              byPosition: true for an API that cuts pages by position (page=2): a later page that
'              has expired (a mutation's expires) is read again by nextPage, not kept.
' Every cached query compares the response body's hash with the cached one: an unchanged
' payload renews the entry without parsing and without a change notification.
sub define(name as string, definition as Definition)
    getStore().callFunc("_define", name, definition)
end sub

' Sends one request and never caches it: sghttp as a plain HTTP client. The request goes
' through a client (the default one, or spec.client), so it gets the baseUrl, shared headers,
' proxy, retries and timeout set up by initialize. Resolves with the whole response
' { code, headers, body, url, ms }: the body JSON-decoded, or the parser's result when a parser
' is named. Rejects with the same shape plus message on a failing status or a network failure
' (code negative).
' @param {Dynamic} spec - a url (relative, or starting with http); the name of a defined query,
'   whose request, client, parser and settings are used but whose cache is neither read nor
'   written; or a FetchSpec: { url, method, headers, body, query, parseJson, retries } as in a
'   definition's request, with {arg} placeholders filled from args and scopes, plus client,
'   auth, proxy, timeout, successCodes and parser as in define, and name, for events. Any other
'   string rejects at once.
function fetch(spec as dynamic, args = {} as object) as object
    return getStore().callFunc("_fetch", spec, args)
end function

' Runs a query. Returns a promise node that resolves with the parsed value.
' Concurrent calls with the same key share one in-flight request; a fresh cached
' value resolves without a request.
' @param {Object} options
'   force      - true skips the memory and disk copies and waits for a request (sharing one
'                already in flight)
'   revalidate - true resolves with the cached value at once, fresh or stale, and checks the
'                server in the background (a different answer reaches watchers, see watch).
'                With nothing cached it behaves like a normal query.
function query(name as string, args = {} as object, options = {} as QueryOptions) as object
    return getStore().callFunc("_query", name, args, options)
end function

' Loads the next page of a query defined with pages and resolves with every page loaded so far
' for these args, { pages, hasNext }: the shape query resolves with for such a query. Nothing
' loaded yet: loads the first page. On the last page (hasNext false): resolves without a
' request. A load already running for these args is shared.
function nextPage(name as string, args = {} as object) as object
    return getStore().callFunc("_nextPage", name, args)
end function

' Starts a query without waiting for its answer, so the query a screen makes later finds it in
' flight or in memory: for data wanted soon, asked for before the screen that shows it opens
' (at launch, or on focus before a select). Does nothing when memory holds a fresh value or a
' request is already in flight; reads the disk first for a persist query, as query does. For
' a query with pages, loads the first page. Returns whether a disk read or request started.
function precache(name as string, args = {} as object) as boolean
    return getStore().callFunc("_precache", name, args)
end function

' Gives up a promise that fetch, query, mutate or nextPage returned. Returns whether it was
' still pending.
' - fetch and mutate: the request is dropped if it is still queued, or aborted if it is in
'   flight and its method is GET or HEAD. A request with any other method that has already been
'   sent is left to finish, since the server may have acted on it. A cancelled call's promise
'   rejects with { cancelled: true, code: 0, message } and emits a "cancel" event, not "error";
'   a mutation's optimistic writes are put back.
' - query and nextPage: the request is shared with other callers, and the cache keeps its
'   answer, so it isn't stopped. If no other caller is waiting on it, it moves to low priority.
'   The caller's own promise still settles.
function cancel(promise as object) as boolean
    return getStore().callFunc("_cancel", promise)
end function

' Runs a cache: false definition (a write, or a per-call resource such as a stream url) and
' applies its removes and expires. Same as query, but rejects for a cached one, so a
' call site reads as a write and cannot quietly cache one.
' @param {Object} options
'   optimistic - [{ name, args, value }]: values set (see set) before the request goes out, so
'                every screen shows the change at once, and put back if the request fails,
'                unless a newer set or a response has replaced one by then.
function mutate(name as string, args = {} as object, options = {} as MutateOptions) as object
    return getStore().callFunc("_query", name, args, { mutation: true, optimistic: options.optimistic })
end function

' Puts a value in the cache for a query and args, as if the server had just answered with it:
' fresh for the definition's ttl, handed to watchers with source "local". For a change the app
' made and already knows the result of. invalid removes the entry. Returns the previous value
' (or invalid), so a failed write can put it back with another set. A response to a request
' that started before the call does not replace the value, though its callers still get it.
' The disk copy is deleted, since it is from before the change.
function set(name as string, args = {} as object, value = invalid as dynamic) as dynamic
    return getStore().callFunc("_set", name, args, value)
end function

' Returns the value cached in memory (fresh, stale or expired) synchronously, else invalid.
' For a query with pages: { pages, hasNext }, every page loaded for these args.
' Never makes a request or reads the disk.
function peek(name as string, args = {} as object) as dynamic
    return getStore().callFunc("_peek", name, args)
end function

' Removes cached entries from memory and disk. Name only: every entry of the query and its
' dotted descendants. Name and args: that one entry. Compare expire, which keeps the value,
' and removeAll, which removes everything.
sub remove(name as string, args = invalid as dynamic)
    getStore().callFunc("_remove", name, args)
end sub

' Removes every cached entry from memory, and every stored body in this app's folder on cachefs:/
' (sign-out). Other apps' folders are never touched.
sub removeAll()
    getStore().callFunc("_removeAll")
end sub

' Marks data the app knows has changed (it just wrote it) as out of date without dropping it.
' peek and revalidate queries still get the kept value; a plain query waits for the server and
' falls back to the kept value if the request fails; a disk copy stored before now is not
' served. Name only: every entry of the query and its dotted descendants. Name and args: that
' one entry. Compare remove, which drops the value and its disk copy.
sub expire(name as string, args = invalid as dynamic)
    getStore().callFunc("_expire", name, args)
end sub

' Sets a scope value (e.g. "profile" -> active profile id). Definitions listing
' this scope get a new key, and entries for the previous value are dropped unless
' options.keep is true.
sub setScope(scopeName as string, value as dynamic, options = {} as ScopeOptions)
    getStore().callFunc("_setScope", scopeName, value, options)
end sub

' Removes every entry whose definition lists this scope, from memory and disk.
sub removeScope(scopeName as string)
    getStore().callFunc("_removeScope", scopeName)
end sub

' Asks the server again, now, for every entry of the query (and its dotted descendants) that
' has a watcher: the ones on screen. With args, that one entry when it is watched; with no
' name, every watched entry. Each keeps serving its value meanwhile, and a different answer
' reaches its watchers. Entries nobody watches are left alone (query with revalidate is for
' one of those). A mutation's expires does this for the queries it expires. Returns a promise
' that resolves, with the number of refreshes started, once they have all settled.
function refresh(name = invalid as dynamic, args = invalid as dynamic) as object
    return getStore().callFunc("_refresh", name, args)
end function

' Marks every cached value stale without dropping it: the next query of each resolves
' with the cached value and checks the server in the background (a difference arrives
' as a change event). For coming back from the background.
sub expireAll()
    getStore().callFunc("_expireAll")
end sub

' Updates the headers sent with every request of a client (merged), the default client's
' when none is named. Use for auth tokens. A header set to invalid is removed:
' setHeaders({ Authorization: invalid }) on sign-out.
sub setHeaders(headers as object, client = "" as string)
    getStore().callFunc("_setHeaders", headers, client)
end sub

' Calls functionName(event) in the calling component when a request that sent the client's
' shared headers is answered 401, so the app can renew them (refresh an access token) in one
' place. The event's data is { client, url }. The request is held rather than failed, and so is
' every other request of the client answered 401 until the app calls reauthorize: with new
' headers they are sent again, once; with invalid they fail with their 401, as does a request
' still in flight from before the event that is answered 401 afterwards. A request sent while
' the headers are being renewed is held too; one with auth: false never is, so the renewal
' request itself must set it. The app must call reauthorize (or setHeaders, which counts as
' reauthorize with those headers) after every event, or the held requests wait.
' A request answered 401 after setHeaders changed the headers it went out with is sent again with
' the new ones, without an event. client: the client to watch, the default client when none is
' named.
sub onUnauthorized(functionName as string, client = "" as string)
    watcher = createObject("roSGNode", "Node")
    watcher.addField("unauthorized", "assocarray", true)
    watcher.observeFieldScoped("unauthorized", functionName)
    getStore().callFunc("_onUnauthorized", watcher, client)
end sub

' The answer to an onUnauthorized event: headers are merged into the client's shared headers as
' setHeaders does, and the held requests are sent again with them; invalid makes them fail with
' their 401 (e.g. the refresh token was rejected and the user must sign in again).
sub reauthorize(headers as dynamic, client = "" as string)
    getStore().callFunc("_reauthorize", headers, client)
end sub

' Calls functionName(event) in the calling component whenever a cached value is replaced
' by different content, typically a background refresh that found new data. The event's
' data is { name, key, source }; match it to a query with isChange(). A first value never
' notifies (the query call that asked for it receives it). For one query, watch is simpler: it
' filters by query and args and delivers the new value.
sub observeChanges(functionName as string)
    getStore().observeFieldScoped("changed", functionName)
end sub

sub unobserveChanges()
    getStore().unobserveFieldScoped("changed")
end sub

' Calls functionName(event) in the calling component when this query's cached value is
' replaced by different content (a refresh found new data). The event's data is
' { name, key, source, value }: the new value is delivered, no query needed. args: only the
' entry those args key to at the time of the change (current scopes and time bucket);
' omitted: every entry of the query. Returns the watcher, for unwatch. A first value never
' notifies (the query call that asked for it receives it).
function watch(name as string, functionName as string, args = invalid as dynamic) as object
    watcher = createObject("roSGNode", "Node")
    watcher.addField("changed", "assocarray", true)
    watcher.observeFieldScoped("changed", functionName)
    getStore().callFunc("_watch", name, args, watcher)
    return watcher
end function

' Stops a watch (when the screen or manager that started it goes away).
sub unwatch(watcher as dynamic)
    if not isNode(watcher) then return
    watcher.unobserveFieldScoped("changed")
    getStore().callFunc("_unwatch", watcher)
end sub

' Calls functionName(event) in the calling component for every cache event (the data is the
' store's lastEvent: { type, name, key, source, ms, client }, plus code and auth on errors), e.g. to
' log, or to send the app to sign-in on a 401.
sub observeEvents(functionName as string)
    getStore().observeFieldScoped("lastEvent", functionName)
end sub

sub unobserveEvents()
    getStore().unobserveFieldScoped("lastEvent")
end sub

' Whether a change event (the data of an observeChanges callback) is for this query, and
' for these args when given. Key matching uses the current scopes and time bucket.
function isChange(change as dynamic, name as string, args = invalid as dynamic) as boolean
    if type(change) <> "roAssociativeArray" or change.name <> name then return false
    if args = invalid then return true
    return change.key = getStore().callFunc("_keyFor", name, args)
end function

' Hit/miss/request counters for instrumentation, plus entries, watchers and per client
' { requests, errors, active } under clients.<name>.
function getStats() as object
    return getStore().callFunc("_getStats")
end function

' Clears the memory cache, stops the tasks and removes the scene field. The disk copies stay:
' call removeAll() first to drop them too.
sub destroy()
    store = getStore()
    if isNode(store) then
        store.callFunc("_destroy")
        m.top.getScene().removeField("__sghttp")
    end if
end sub
