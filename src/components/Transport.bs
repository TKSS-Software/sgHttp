import "pkg:/source/roku_modules/promises/promises.brs"
import "pkg:/source/keys.bs"
import "pkg:/source/client.bs"

' Default HTTP transport: an HttpClient (see source/client.bs) on a task of its own, behind the
' makeRequest(spec) contract any replacement node can meet via initialize({ transport: node }) or
' a client's transport. The store starts it (control RUN) once its fields are set: the client is
' made from them when the task starts. headers can change at any time.
' promote: { id, priority } moves a queued request: up when a caller that waits on it joins it,
'   down when its callers give up.
' cancel: { id, queuedOnly } drops the request whose promise has that id if it is still waiting,
'   or aborts it in flight unless queuedOnly; its promise rejects with { cancelled: true }.

sub init()
    m.port = createObject("roMessagePort")
    m.top.observeField("request", m.port)
    m.top.observeField("promote", m.port)
    m.top.observeField("cancel", m.port)
    m.top.observeField("shutdown", m.port)
    m.top.observeField("headers", m.port)
    ' Settings a running transport takes a change of, as it always has
    for each field in ["baseUrl", "proxy", "retries", "timeoutSeconds"]
        m.top.observeField(field, m.port)
    end for
    m.top.functionName = "runTransport"
end sub

' Render-thread entry point. Returns a promise node settled by the task thread.
function makeRequest(spec as object) as object
    promise = promises.create()
    if type(spec) <> "roAssociativeArray" or not isNonEmptyString(spec.url) then
        promises.reject({ message: "sghttp transport: request needs a url" }, promise)
        return promise
    end if
    m.top.activeRequests = m.top.activeRequests + 1
    ' Counted down here too, on the render thread, as the promise settles (see onRequestSettled):
    ' the task never touches the count, which would be two rendezvous per request
    promise.observeFieldScoped("promiseState", "onRequestSettled")
    ' The id travels with the request: read here, on the thread that owns the promise, it costs
    ' the task nothing; read there, it is a rendezvous
    m.top.request = { promise: promise, id: promise.id, spec: spec }
    return promise
end function

' Render thread: a request's promise has settled. Its observer was registered before the
' caller's, so the count is down before the caller's callbacks run.
sub onRequestSettled(event as object)
    event.getRoSGNode().unobserveFieldScoped("promiseState")
    m.top.activeRequests = m.top.activeRequests - 1
end sub

sub runTransport()
    client = createHttpClient({
        baseUrl: m.top.baseUrl
        headers: m.top.headers
        baseHeaders: m.top.baseHeaders
        maxConcurrent: m.top.maxConcurrent
        timeout: m.top.timeoutSeconds
        retries: m.top.retries
        httpVersion: m.top.httpVersion
        proxy: m.top.proxy
    }, m.port)
    lastRequestId = ""
    while true
        message = wait(client.nextWait(), m.port)
        if type(message) = "roSGNodeEvent" then
            field = message.getField()
            if field = "request" then
                request = message.getData()
                if type(request) = "roAssociativeArray" and isNode(request.promise) then
                    id = request.id
                    if not isNonEmptyString(id) then id = request.promise.id
                    ' See ParserTask.runJob: a request delivered twice means another was lost
                    if id = lastRequestId then print `[sghttp] transport: request ${id} delivered twice (field events coalesced)`
                    lastRequestId = id
                    client.send(request.spec, request.promise, id)
                end if
            else if field = "promote" then
                data = message.getData()
                if type(data) = "roAssociativeArray" and isNonEmptyString(data.id) then client.promote(data.id, data.priority)
            else if field = "cancel" then
                data = message.getData()
                if type(data) = "roAssociativeArray" and isNonEmptyString(data.id) then client.cancel(data.id, data.queuedOnly = true)
            else if field = "headers" then
                client.headers = message.getData()
                if client.headers = invalid then client.headers = {}
            else if field = "shutdown" then
                return
            else if field = "baseUrl" or field = "proxy" then
                client[field] = message.getData()
            else if field = "retries" then
                client.retries = message.getData()
            else if field = "timeoutSeconds" then
                client.timeout = message.getData()
            end if
        end if
        client.handle(message)
    end while
end sub
