import "pkg:/source/roku_modules/promises/promises.brs"
import "pkg:/source/keys.bs"

' The cache singleton. Everything lives in m (never in fields) so reads never copy.
' Entry shape in m.cache[key]:
'   { id, name, scopes, promise, value, hasValue, storedAt, freshUntil, hash, etag, lastModified,
'     expired, expiredSequence }
'   id       - unique per entry, so a request can tell the entry it started for from one made
'              after a drop
'   promise  - pending promise while a fetch is in flight (shared by all callers)
'   value    - resolved value once settled (node or AA)
'   hash     - MD5 of the raw body the value was parsed from ("" when unknown)
'   parsedHash - MD5 of the parsed value's JSON, for compare: "parsed" ("" otherwise)
'   etag, lastModified - the response's validators, sent back by conditional definitions
'   expired  - set by expire(): the value is kept but known to be out of date, so a plain
'              fetch waits for the server
'   expiredSequence - the request sequence number at expiry: a request started before it
'              answers its own callers but never writes to the entry
'   bucket   - the time bucket the key was made in (bucket definitions), -1 otherwise

const PERSIST_DIR = "cachefs:/sghttp"
' Where bodies were stored when the library was called sgQuery
const OLD_PERSIST_DIR = "cachefs:/sgquery"
' A file is one line of JSON describing the body (its format, the cache version, request and
' key it belongs to, when it was stored, its hash and validators, and whether it is decoded as
' JSON), then the body's text exactly as the server sent it. Only the first line is decoded on
' the render thread; a parser's body goes to its task as text.
const ENVELOPE_FORMAT = 2

' The client made from initialize's top-level settings, used by definitions without a client
const DEFAULT_CLIENT = "default"
' Which build of sghttp this is: scripts/build.js writes the commit and build time over this
' in dist, so the device log shows whether a sideload carries the latest sghttp
const BUILD_STAMP = "unstamped (compiled from source)"

sub init()
    m.definitions = {}
    m.cache = {}
    m.order = []
    m.scopes = {}
    ' client name -> { name, transport, headers, requests, errors } (see addClient)
    m.clients = {}
    ' query name -> [{ node, args }] (watch)
    m.watchers = {}
    ' query name or key -> seconds of the last expire(), so a disk copy older than it is skipped.
    ' Only persisted queries need one, and a record goes once the disk copy it guards is
    ' rewritten or deleted (see dropExpiries)
    m.expiries = {}
    ' query name -> the time bucket its entries were last swept at (see dropOldBuckets)
    m.buckets = {}
    ' promise id -> the context of a fetch or mutation, until it settles (see _cancel)
    m.calls = {}
    ' Counts requests handed to a transport, so a 401 can tell whether the request went out
    ' before the shared headers were last renewed (see holdUnauthorized)
    m.sendCount = 0
    ' Counts request starts and expiries, ordering them (see currentEntry)
    m.sequence = 0
    m.nextEntryId = 0
    m.lastSetId = 0
    ' Persistence ops held back until the first disk read (see runCleanups)
    m.cleanups = invalid
    ' The persistence task, once something needs the disk (see diskTask)
    m.persistEnabled = false
    m.persistence = invalid
    m.givenPersistence = invalid
    m.stats = { hits: 0, staleHits: 0, misses: 0, diskHits: 0, requests: 0, errors: 0, unchanged: 0, changes: 0 }
    m.parsers = []
    m.initialized = false
end sub

function _initialize(params = {} as object) as object
    print `[sghttp] build ${BUILD_STAMP}`
    ' The top-level settings are the default client, as an app with one server has always
    ' passed them; params.clients adds a client per other server
    m.clients = {}
    addClient(DEFAULT_CLIENT, params)
    if type(params.clients) = "roAssociativeArray" then
        for each clientName in params.clients
            settings = params.clients[clientName]
            if clientName = DEFAULT_CLIENT then
                print `[sghttp] a client cannot be named "${DEFAULT_CLIENT}"; the top-level settings are that client`
            else if type(settings) = "roAssociativeArray" then
                addClient(clientName, settings)
            end if
        end for
    end if

    ' A few parser tasks, so a small body is never parsed behind a large one while another
    ' task sits idle (see parseOnTask). Each is its own thread with its own parser instances.
    m.parsers = []
    if isNonEmptyString(params.parserTask) then
        count = 2
        if isWholeNumber(params.parserThreads) and params.parserThreads > 0 then count = params.parserThreads
        for i = 1 to count
            m.parsers.push({ node: createObject("roSGNode", params.parserTask), pending: 0 })
        end for
    end if

    m.persistEnabled = params.persist <> false
    ' Prints every event and change with its key (see emit)
    m.debug = params.debug = true
    m.version = isNonEmptyString(params.version) ? params.version : "1"
    m.maxEntries = (type(params.maxEntries) = "roInt" or type(params.maxEntries) = "roInteger" or type(params.maxEntries) = "Integer") ? params.maxEntries : 100
    m.defaultTtl = (type(params.defaultTtl) = "roInt" or type(params.defaultTtl) = "roInteger" or type(params.defaultTtl) = "Integer") ? params.defaultTtl : 300

    ' This app's folder: sideloaded apps all run as the "dev" channel and may share cachefs, so
    ' every app (and every version of it) keeps its bodies apart from the others'
    m.persistDir = PERSIST_DIR + "/" + persistNamespace(params)
    ' The persistence task starts at the first call that needs the disk (see diskTask), so an app
    ' that only sends requests never runs it or touches cachefs:/. A persistence task of the
    ' caller's (tests): file operations of several stores then run in one queue, in order, and
    ' _destroy leaves it running.
    m.persistence = invalid
    m.ownsPersistence = false
    m.givenPersistence = params.persistence
    if m.persistEnabled then
        ' Clean-ups wait until the first disk read has answered (see runCleanups), so a cold
        ' start never queues behind them. Bodies stored while the library was called sgQuery are
        ' never read again: this app's folders under OLD_PERSIST_DIR go, and the files of the
        ' layout before the per-app folders, which sat directly under it. A new version of the
        ' app starts with an empty disk cache, so its earlier versions' folders go too (only for
        ' the derived namespace; a chosen one is left to the app).
        namespace = m.persistDir.mid(PERSIST_DIR.len() + 1)
        m.cleanups = [{ type: "clearLegacy", dir: OLD_PERSIST_DIR }]
        if isNonEmptyString(params.namespace) then
            m.cleanups.push({ type: "clearQuery", dir: OLD_PERSIST_DIR, name: namespace, descendants: false })
        else
            m.cleanups.push({ type: "clearSiblings", dir: OLD_PERSIST_DIR, prefix: m.appPrefix, keep: "" })
            m.cleanups.push({ type: "clearSiblings", dir: PERSIST_DIR, prefix: m.appPrefix, keep: namespace })
        end if
    end if

    m.initialized = true
    return m.top
end function

'*************************************************************************
'#region Clients
'*************************************************************************

' A server the store talks to, with its own transport (so a slow server cannot hold up
' another's requests) and its own shared headers. A client inherits nothing from the
' default one. settings: { baseUrl, headers, baseHeaders, proxy, maxConcurrent, timeout,
' retries, httpVersion, transport }
sub addClient(name as string, settings as object)
    transport = settings.transport
    ownTransport = not isNode(transport)
    if ownTransport then transport = createObject("roSGNode", "Transport")
    headers = {}
    if type(settings.headers) = "roAssociativeArray" then headers.append(settings.headers)
    if isNonEmptyString(settings.baseUrl) then setTransportField(transport, "baseUrl", settings.baseUrl)
    if isNonEmptyString(settings.proxy) then setTransportField(transport, "proxy", settings.proxy)
    if isNonEmptyString(settings.httpVersion) then setTransportField(transport, "httpVersion", settings.httpVersion)
    if type(settings.baseHeaders) = "roAssociativeArray" then setTransportField(transport, "baseHeaders", settings.baseHeaders)
    if isWholeNumber(settings.maxConcurrent) and settings.maxConcurrent > 0 then setTransportField(transport, "maxConcurrent", settings.maxConcurrent)
    if isWholeNumber(settings.timeout) and settings.timeout > 0 then setTransportField(transport, "timeoutSeconds", settings.timeout)
    if isWholeNumber(settings.retries) and settings.retries >= 0 then setTransportField(transport, "retries", settings.retries)
    setTransportField(transport, "headers", headers)
    ' Started only now that its settings are in (it reads some of them as it starts)
    if ownTransport then transport.control = "RUN"
    ' authWatcher, held, renewing, renewedAt and deniedAt: see holdUnauthorized
    m.clients[name] = { name: name, transport: transport, headers: headers, baseUrl: asString(settings.baseUrl), requests: 0, errors: 0, authWatcher: invalid, held: [], renewing: false, renewedAt: 0, deniedAt: 0 }
end sub

' A replacement transport (tests, an app's own) need not have every field
sub setTransportField(transport as object, field as string, value as dynamic)
    if transport.hasField(field) then transport[field] = value
end sub

' The client a definition sends through, or invalid when it names one that does not exist
function clientOf(definition as object) as dynamic
    return m.clients[definition.client]
end function

function noClientError(definition as object) as object
    return { message: `sghttp: query "${definition.name}" names client "${definition.client}", which initialize did not set up`, code: 0 }
end function

'#endregion

'*************************************************************************
'#region Definitions and scopes
'*************************************************************************

sub _define(name as string, definition as object)
    if m.definitions[name] <> invalid then
        print `[sghttp] "${name}" is defined again: the new definition replaces the first`
    end if
    normalized = normalize(name, definition)
    if type(definition.request) = "roAssociativeArray" and definition.request.toFile <> invalid then
        print `[sghttp] "${name}": toFile is for fetch, ignoring it; a query's value is kept in the cache, not a file`
    end if
    if definition.invalidates <> invalid then
        print `[sghttp] "${name}": invalidates was renamed to removes, ignoring it`
    end if
    clientName = normalized.client
    ' Names the persisted file: a body stored under another request (url, query, method),
    ' parser or server is never read again, since the key alone does not say where a value came
    ' from. The server is the client (for any but the default) and its baseUrl, so a build
    ' pointed at QA never reads bodies stored against production.
    requestText = formatJson(definition.request) + "|" + asString(definition.parser)
    if clientName <> DEFAULT_CLIENT then requestText = requestText + "|" + clientName
    client = m.clients[clientName]
    url = type(definition.request) = "roAssociativeArray" ? asString(definition.request.url) : ""
    ' An absolute url ignores baseUrl (see Transport.startJob), so its bodies survive a change of API host
    if client <> invalid and client.baseUrl <> "" and url.left(4) <> "http" then requestText = requestText + "|" + client.baseUrl
    normalized.requestHash = hashString(requestText)
    m.definitions[name] = normalized
    ' A copy stored by an earlier launch may be deleted (set, remove) before it is ever read
    if normalized.persist then diskTask()
end sub

' A definition with every key present and defaulted, as the fetch path reads it
function normalize(name as string, definition as object) as object
    clientName = isNonEmptyString(definition.client) ? definition.client : DEFAULT_CLIENT
    ' A GraphQL mutation is a write: never cached, retried or aborted as a read would be. Later
    ' pages may be fetched with pages.request (see buildRequestSpec): GraphQL there unwraps too
    graphql = hasGraphql(definition.request) or (type(definition.pages) = "roAssociativeArray" and hasGraphql(definition.pages.request))
    graphqlMutation = hasGraphql(definition.request) and isGraphqlMutation(definition.request.graphql.query, asString(definition.request.graphql.operationName))
    if m.clients[clientName] = invalid then
        print `[sghttp] "${name}" names client "${clientName}", which initialize did not set up; its requests will fail`
    end if
    normalized = {
        name: name
        request: definition.request
        parser: definition.parser
        ttl: definition.ttl
        staleWhileRevalidate: definition.staleWhileRevalidate <> false
        persist: definition.persist = true
        scopes: type(definition.scopes) = "roArray" ? definition.scopes : []
        bucket: definition.bucket
        successCodes: definition.successCodes
        cache: definition.cache <> false and not graphqlMutation
        graphql: graphql
        graphqlMutation: graphqlMutation
        removes: type(definition.removes) = "roArray" ? definition.removes : []
        expires: type(definition.expires) = "roArray" ? definition.expires : []
        auth: definition.auth <> false
        timeout: definition.timeout
        proxy: definition.proxy <> false
        conditional: definition.conditional = true
        compare: definition.compare = "parsed" ? "parsed" : "body"
        client: clientName
        pages: normalizePages(definition.pages)
        priority: priorityLevel(definition.priority, "normal")
        ' Without a ttl of its own, a response's Cache-Control sets the freshness (see ttlFor)
        ttlGiven: definition.ttl <> invalid
    }
    ' ttl: invalid -> store default; negative -> fresh until removed
    if normalized.ttl = invalid then normalized.ttl = m.defaultTtl
    return normalized
end function

' pages: { next: path in a page's value to the next page's cursor (empty or missing on the last
' page), arg: the arg the cursor is passed as (default "next"), request: the request for pages
' after the first (default: the definition's), hasNext: path in a page's value to whether a page
' follows it, for an API whose last page still has a cursor (GraphQL's Relay pageInfo:
' endCursor and hasNextPage), byPosition: the API cuts pages by position
' (page=2), so a change anywhere shifts entries onto the pages after it: a later page that has
' expired is read again rather than kept (see lastPage) }, or invalid for a query without pages
function normalizePages(pages as dynamic) as dynamic
    if type(pages) <> "roAssociativeArray" or not isNonEmptyString(pages.next) then return invalid
    return {
        next: pages.next
        arg: isNonEmptyString(pages.arg) ? pages.arg : "next"
        request: type(pages.request) = "roAssociativeArray" ? pages.request : invalid
        hasNext: isNonEmptyString(pages.hasNext) ? pages.hasNext : invalid
        byPosition: pages.byPosition = true
    }
end function

' One request with no definition and no cache: sghttp as a plain HTTP client. The spec is a
' url, or a define request (url, method, headers, body, query, parseJson, retries) plus the
' definition keys a request can use (client, auth, proxy, timeout, successCodes, parser) and a
' name for events. Resolves with the whole response, since a caller here wants the status and
' headers.
function _fetch(spec as dynamic, args = {} as object) as object
    if type(spec) = "roString" or type(spec) = "String" then
        if spec.left(1) <> "/" and lcase(spec.left(4)) <> "http" then
            ' The name of a defined query: its request is sent as is, with the definition's
            ' client, headers, parser and the rest, but nothing is read from or kept in the cache.
            ' Any other string would quietly become a request to baseUrl/<string>.
            definition = m.definitions[spec]
            if definition = invalid then return promises.reject({ message: `sghttp: fetch takes a url or the name of a defined query; "${spec}" is neither`, code: 0 })
            if type(args) <> "roAssociativeArray" then args = {}
            return runUncached(definition, args, true)
        end if
        spec = { url: spec }
    end if
    if type(spec) <> "roAssociativeArray" or not isNonEmptyString(spec.url) then
        return promises.reject({ message: "sghttp: fetch needs a url", code: 0 })
    end if
    if type(args) <> "roAssociativeArray" then args = {}
    if spec.toFile <> invalid then
        problem = downloadProblem(spec)
        if problem <> "" then return promises.reject({ message: `sghttp: fetch with toFile ${problem}`, code: 0 })
    end if
    name = isNonEmptyString(spec.name) ? spec.name : "fetch"
    definition = normalize(name, {
        request: spec
        client: spec.client
        auth: spec.auth
        proxy: spec.proxy
        timeout: spec.timeout
        successCodes: spec.successCodes
        parser: spec.parser
        priority: spec.priority
        cache: false
    })
    ' Set here, not by normalize: only a fetch downloads to a file (see _define)
    if spec.toFile <> invalid then definition.toFile = spec.toFile
    return runUncached(definition, args, true)
end function

' Why a fetch can't download to a file as asked, or "": the body goes to the file, so there is
' nothing to decode or parse, and only a GET is sent that way
function downloadProblem(spec as object) as string
    if not isNonEmptyString(spec.toFile) then return "needs a path"
    if isNonEmptyString(spec.method) and ucase(spec.method) <> "GET" then return "is a GET; it can't be sent as " + ucase(spec.method)
    if isNonEmptyString(spec.parser) then return "has no body to parse; it can't name a parser"
    if type(spec.graphql) = "roAssociativeArray" then return "can't be a GraphQL request"
    return ""
end function

sub _setScope(scopeName as string, value as dynamic, options = {} as object)
    previous = m.scopes[scopeName]
    m.scopes[scopeName] = value
    if options.keep <> true and previous <> invalid and previous <> value then
        _removeScope(scopeName)
    end if
end sub

' Merged into the client's shared headers (the default client's when none is named). A header
' set to invalid is removed, e.g. Authorization on sign-out.
sub _setHeaders(headers as object, clientName = "" as string)
    if clientName = "" then clientName = DEFAULT_CLIENT
    client = m.clients[clientName]
    if client = invalid then
        print `[sghttp] setHeaders: no client "${clientName}"`
        return
    end if
    if type(headers) = "roAssociativeArray" then
        for each headerName in headers
            value = headers[headerName]
            if value = invalid then
                client.headers.delete(headerName)
            else
                client.headers[headerName] = value
            end if
        end for
        setTransportField(client.transport, "headers", client.headers)
        client.renewedAt = m.sendCount
        ' An app that answers onUnauthorized with setHeaders, not reauthorize, renews all the same
        if client.renewing then settleHeld(client, true)
    end if
end sub

' The node whose unauthorized field is set when one of this client's requests is answered 401
' (see holdUnauthorized); invalid stops it.
sub _onUnauthorized(watcher as dynamic, clientName = "" as string)
    if clientName = "" then clientName = DEFAULT_CLIENT
    client = m.clients[clientName]
    if client = invalid then
        print `[sghttp] onUnauthorized: no client "${clientName}"`
        return
    end if
    client.authWatcher = isNode(watcher) ? watcher : invalid
end sub

' The app's answer to an unauthorized event: headers (merged as setHeaders does) send the held
' requests again with them; invalid lets them fail with their 401.
sub _reauthorize(headers as dynamic, clientName = "" as string)
    if clientName = "" then clientName = DEFAULT_CLIENT
    client = m.clients[clientName]
    if client = invalid then
        print `[sghttp] reauthorize: no client "${clientName}"`
        return
    end if
    if type(headers) = "roAssociativeArray" then
        _setHeaders(headers, clientName)   ' sends the held requests again with them
    else
        ' The app was asked once for every request sent so far: a 401 to another of them fails
        ' at once, instead of asking again (see holdUnauthorized)
        client.deniedAt = m.sendCount
        settleHeld(client, false)
    end if
end sub

' Ends a client's renewal: its held requests go again with the renewed headers, or fail with
' their 401
sub settleHeld(client as object, renewed as boolean)
    client.renewing = false
    held = client.held
    client.held = []
    for each context in held
        if renewed then
            resend(client, context)
        else
            promises.reject(context.authError, context.reply)
        end if
    end for
end sub

function _getStats() as object
    stats = {}
    stats.append(m.stats)
    stats.entries = m.cache.count()
    watchers = 0
    for each name in m.watchers
        watchers += m.watchers[name].count()
    end for
    stats.watchers = watchers
    clients = {}
    for each clientName in m.clients
        client = m.clients[clientName]
        active = 0
        if client.transport.hasField("activeRequests") then active = client.transport.activeRequests
        clients[client.name] = { requests: client.requests, errors: client.errors, active: active }
    end for
    stats.clients = clients
    return stats
end function

'#endregion

'*************************************************************************
'#region Fetch
'*************************************************************************

function _query(name as string, args = {} as object, options = {} as object) as object
    definition = m.definitions[name]
    if definition = invalid then
        return promises.reject({ message: `sghttp: no query named "${name}"` })
    end if
    if type(args) <> "roAssociativeArray" then args = {}
    if type(options) <> "roAssociativeArray" then options = {}

    if options.mutation = true and definition.cache then
        return promises.reject({ message: `sghttp: "${name}" is a cached query; mutate() runs cache: false definitions` })
    end if
    ' Mutations and per-call resources: straight through the transport, never stored
    if not definition.cache then
        if type(options.optimistic) = "roArray" and options.optimistic.count() > 0 then return runOptimistic(definition, args, options.optimistic)
        return runUncached(definition, args)
    end if

    lookup = runQuery(definition, args, options)
    if lookup.promise <> invalid then return lookup.promise
    return promises.resolve(answerFor(definition, lookup.key, m.cache[lookup.key].value))
end function

' Starts a query without waiting for it, so a later query finds it in flight or in memory:
' for data a screen will want, asked for before the screen opens. Nothing happens when
' memory holds a fresh value or a request is already in flight. Returns whether a disk
' read or a request started.
function _precache(name as string, args = {} as object) as boolean
    definition = m.definitions[name]
    if definition = invalid then
        print `[sghttp] precache: no query named "${name}"`
        return false
    end if
    if not definition.cache then
        print `[sghttp] precache: "${name}" is cache: false, nothing to keep`
        return false
    end if
    if type(args) <> "roAssociativeArray" then args = {}
    now = nowSeconds()
    entry = m.cache[buildKey(name, definition, args, m.scopes, now)]
    if entry <> invalid then
        if entry.promise <> invalid then return false
        if entry.hasValue and not entry.expired and now < entry.freshUntil then return false
    end if
    ' Nothing waits on a precache, so it queues behind the requests screens are waiting on
    lookup = runQuery(definition, args, { priority: "low" })
    ' ...and it is no caller's claim on the request (see releaseWaiter)
    started = m.cache[lookup.key]
    if started <> invalid and started.fetch <> invalid then started.fetch.waiters = 0
    return true
end function

' Gives up a promise fetch, query, mutate or nextPage returned. A fetch or mutation is
' cancelled: dropped if it is still queued, aborted if it is in flight and its method is GET or
' HEAD (any other method may already have changed something on the server, so it is left to
' finish), and its promise rejects with { cancelled: true }. A cached query's request is shared,
' and the cache still wants its answer, so the caller only gives up its claim: a request no one
' else is waiting on drops to low priority. Returns whether the promise was still pending.
function _cancel(promise as dynamic) as boolean
    if not isNode(promise) then return false
    context = m.calls[promise.id]
    if context <> invalid then
        cancelCall(context)
        return true
    end if
    for each key in m.cache
        entry = m.cache[key]
        if isNode(entry.promise) and entry.promise.isSameNode(promise) then return releaseWaiter(entry.fetch)
    end for
    return false
end function

sub cancelCall(context as object)
    client = clientOf(context.definition)
    ' Held after a 401, it has changed nothing on the server, whatever its method
    if client <> invalid and releaseHeld(client, context) then
        context.cancelled = true
        promises.reject(cancelledError(), context.reply)
        return
    end if
    ' A safe request's answer is dropped however it arrives: aborted, already parsing, or from
    ' a transport that can't cancel
    if context.safeToAbort then context.cancelled = true
    if client <> invalid and isNode(context.requestPromise) and client.transport.hasField("cancel") then
        client.transport.cancel = { id: context.requestPromise.id, queuedOnly: not context.safeToAbort }
    end if
end sub

' A caller of a cached query gave up: when no caller is left waiting on the request, it moves
' behind the requests that are still wanted. A later caller raises it again (see promote).
function releaseWaiter(context as dynamic) as boolean
    if type(context) <> "roAssociativeArray" then return false
    if context.waiters > 0 then context.waiters--
    if context.waiters > 0 or context.priority = "low" then return true
    context.priority = "low"
    if isNode(context.requestPromise) then
        client = clientOf(context.definition)
        if client <> invalid and client.transport.hasField("promote") then client.transport.promote = { id: context.requestPromise.id, priority: "low" }
    end if
    return true
end function

function cancelledError() as object
    return { code: 0, kind: "cancelled", cancelled: true, message: "sghttp: cancelled" }
end function

' The cached path of _query: { key, promise }, where promise is the request that will answer
' (in flight, or started now), or invalid when memory answers with the entry's value. A
' memory answer makes no promise here, so a caller that shapes the value (pages) resolves once.
function runQuery(definition as object, args as object, options as object) as object
    name = definition.name
    now = nowSeconds()
    dropOldBuckets(definition, now)
    key = buildKey(name, definition, args, m.scopes, now)
    entry = m.cache[key]
    force = options.force = true
    revalidate = options.revalidate = true

    if entry <> invalid and not force then
        ' In flight: share the pending promise, unless memory can answer now: a value that is
        ' fresh, or stale and served while it is checked, is not held behind its own refresh
        servable = entry.hasValue and not entry.expired and (revalidate or now < entry.freshUntil or definition.staleWhileRevalidate)
        if entry.promise <> invalid and not servable then
            emit("dedupe", name, key, "memory", 0)
            ' This caller waits on the request, so it goes ahead of anything queued lower
            if entry.fetch <> invalid then entry.fetch.waiters++
            promote(entry.fetch, priorityFor(definition, options, false))
            return { key: key, promise: entry.promise }
        end if

        if entry.hasValue then
            ' Revalidate: the cached value now, fresh or not, and a background check that
            ' notifies `changed` if the server's copy differs
            ' A value served from memory counts as a use: it is the last to be evicted
            touch(key)
            if revalidate then
                m.stats.staleHits++
                emit("stale", name, key, "memory", 0)
                startFetch(definition, key, args, now, true, false, false, priorityFor(definition, options, true))
                return { key: key, promise: invalid }
            end if
            ' Known to be out of date (expire): wait for the server; the kept value answers if
            ' the request fails
            if entry.expired then
                m.stats.misses++
                return { key: key, promise: startFetch(definition, key, args, now, false, true, false, priorityFor(definition, options, false)) }
            end if
            if now < entry.freshUntil then
                m.stats.hits++
                emit("hit", name, key, "memory", 0)
                return { key: key, promise: invalid }
            end if

            if definition.staleWhileRevalidate then
                m.stats.staleHits++
                emit("stale", name, key, "memory", 0)
                startFetch(definition, key, args, now, true, false, false, priorityFor(definition, options, true))
                return { key: key, promise: invalid }
            end if
        end if
    end if

    m.stats.misses++
    ' force asks the server: a disk copy is not an answer to it
    return { key: key, promise: startFetch(definition, key, args, now, false, false, force, priorityFor(definition, options, false)) }
end function

' The priority a request is queued at: the call's own option when it gives one, else low
' for a background request (a refresh or a precache, which nothing waits on), else the
' definition's
function priorityFor(definition as object, options as object, background as boolean) as string
    if type(options) = "roAssociativeArray" and isNonEmptyString(options.priority) then return priorityLevel(options.priority, definition.priority)
    if background then return "low"
    return definition.priority
end function

' A priority as the transport takes it: "high", "normal" or "low", else fallback
function priorityLevel(value as dynamic, fallback as string) as string
    if isNonEmptyString(value) and (value = "high" or value = "normal" or value = "low") then return value
    return fallback
end function

function priorityRank(level as dynamic) as integer
    if level = "high" then return 2
    if level = "low" then return 0
    return 1
end function

' A caller that will wait on a request has joined it: if it is queued lower than the caller,
' it moves up. Before the request is sent (a disk read first), the fetch just remembers the
' level; a transport without a promote field keeps its order.
sub promote(context as dynamic, priority as string)
    if type(context) <> "roAssociativeArray" then return
    if priorityRank(priority) <= priorityRank(context.priority) then return
    context.priority = priority
    if not isNode(context.requestPromise) then return
    client = clientOf(context.definition)
    if client <> invalid and client.transport.hasField("promote") then client.transport.promote = { id: context.requestPromise.id, priority: priority }
end sub

function _peek(name as string, args = {} as object) as dynamic
    definition = m.definitions[name]
    if definition = invalid then return invalid
    key = buildKey(name, definition, args, m.scopes, nowSeconds())
    entry = m.cache[key]
    if entry = invalid or not entry.hasValue then return invalid
    if definition.pages <> invalid then return assemblePages(definition, key)
    return entry.value
end function

'#endregion

'*************************************************************************
'#region Local writes
'*************************************************************************

' Puts a value in the cache for these args, as fresh as a response now, and hands it to
' watchers (source "local"): for a change the app made and already knows the result of.
' invalid removes the entry. Returns the previous value, or invalid, so a failed write can
' put it back. A response to a request that started before the write does not replace it
' (its callers still get it); the disk copy is deleted, since it is from before the change.
function _set(name as string, args = {} as object, value = invalid as dynamic) as dynamic
    definition = m.definitions[name]
    if definition = invalid then
        print `[sghttp] set: no query named "${name}"`
        return invalid
    end if
    if not definition.cache then
        print `[sghttp] set: "${name}" is cache: false, nothing to set`
        return invalid
    end if
    if type(args) <> "roAssociativeArray" then args = {}
    now = nowSeconds()
    key = buildKey(name, definition, args, m.scopes, now)
    entry = m.cache[key]
    previous = invalid
    if entry <> invalid and entry.hasValue then previous = entry.value
    if value = invalid then
        _remove(name, args)
        return previous
    end if

    if entry = invalid then
        entry = newEntry(definition, now, args)
        insertEntry(key, entry)
    else
        touch(key)
    end if
    ' A request in flight answers its callers but is not stored over this value; a query
    ' from now on is answered from memory rather than joining it
    m.sequence++
    entry.expiredSequence = m.sequence
    entry.promise = invalid
    entry.fetch = invalid
    recut = definition.pages <> invalid and entry.hasValue and asString(nextCursor(definition, entry)) <> asString(cursorOf(definition, value))
    entry.value = value
    entry.hasValue = true
    entry.expired = false
    ' No server bytes behind this value: the next response is always a change
    entry.hash = ""
    entry.parsedHash = ""
    entry.etag = ""
    entry.lastModified = ""
    entry.storedAt = now
    entry.freshUntil = (definition.ttl < 0) ? 2147483647 : now + definition.ttl
    m.lastSetId++
    entry.setId = m.lastSetId
    deletePersisted(key)
    emit("set", name, key, "local", 0)
    if definition.pages <> invalid then
        if recut then resetPagesAfter(key, entry)
        headKey = isNonEmptyString(entry.head) ? entry.head : key
        notifyChange(name, headKey, "local", assemblePages(definition, headKey))
    else
        notifyChange(name, key, "local", value)
    end if
    return previous
end function

' A mutation with optimistic writes: the writes go in first, and come back out if the
' mutation fails, unless a newer write or a response has replaced one meanwhile
function runOptimistic(definition as object, args as object, writes as object) as object
    undo = []
    for each write in writes
        if type(write) = "roAssociativeArray" and isNonEmptyString(write.name) then
            previous = _set(write.name, write.args, write.value)
            undo.push({ name: write.name, args: write.args, previous: previous, setId: m.lastSetId })
        end if
    end for
    pending = promises.create()
    request = runUncached(definition, args)
    context = { undo: undo, pending: pending }
    ' The caller holds this promise, not the request's: cancel finds the request through it
    if m.calls[request.id] <> invalid then m.calls[pending.id] = m.calls[request.id]
    promises.chain(request, context).then(function(value as dynamic, context as object) as dynamic
        m.calls.delete(context.pending.id)
        promises.resolve(value, context.pending)
        return invalid
    end function).catch(function(error as dynamic, context as object) as dynamic
        m.calls.delete(context.pending.id)
        for each write in context.undo
            rollback(write)
        end for
        promises.reject(error, context.pending)
        return invalid
    end function).toPromise()
    return pending
end function

' Puts the value from before an optimistic write back, if the write's value is still there
sub rollback(write as object)
    definition = m.definitions[write.name]
    if definition = invalid then return
    args = type(write.args) = "roAssociativeArray" ? write.args : {}
    entry = m.cache[buildKey(write.name, definition, args, m.scopes, nowSeconds())]
    if entry = invalid or entry.setId <> write.setId then return
    _set(write.name, args, write.previous)
end sub

'#endregion

'*************************************************************************
'#region Pages
'*************************************************************************
' A query with pages keeps each page as an ordinary entry, keyed by its own args (the first
' page's args plus the cursor), so a page is deduplicated, kept fresh, persisted and compared
' like any value. The first page's entry (the head) lists the keys of the pages loaded after
' it, in order (chain); each of those names the head. query and nextPage resolve with every
' page in the chain: { pages, hasNext }.

' Loads the page after the last one loaded for these args and resolves with all of them.
' Nothing loaded yet: the first page. No next page: the pages as they are, without a request.
' A load already running for these args is shared.
function _nextPage(name as string, args = {} as object) as object
    definition = m.definitions[name]
    if definition = invalid then return promises.reject({ message: `sghttp: no query named "${name}"` })
    if definition.pages = invalid then return promises.reject({ message: `sghttp: "${name}" has no pages: define it with pages: { next, arg }` })
    if type(args) <> "roAssociativeArray" then args = {}
    now = nowSeconds()
    headKey = buildKey(name, definition, args, m.scopes, now)
    head = m.cache[headKey]
    if head = invalid or not head.hasValue then return _query(name, args)
    if head.nextPending <> invalid then return head.nextPending
    cursor = nextCursor(definition, lastPage(head))
    if cursor = invalid then return promises.resolve(assemblePages(definition, headKey))

    nextArgs = {}
    nextArgs.append(args)
    nextArgs[definition.pages.arg] = cursor
    lookup = runQuery(definition, nextArgs, {})
    if lookup.promise = invalid then
        linkPage(headKey, lookup.key)
        return promises.resolve(assemblePages(definition, headKey))
    end if
    ' The fetch links the page to this head as it settles (see finishLink), and resolves with
    ' every page (see answerFor). A fetch already in flight for the page takes the link too.
    running = m.cache[lookup.key].fetch
    if running <> invalid then running.link = { headKey: headKey, headId: head.id }
    head.nextPending = lookup.promise
    return lookup.promise
end function

' A nextPage fetch has settled: its head stops waiting, and on success the page joins the
' head's chain, if the head is still the one it was loaded for. A head dropped or replaced
' meanwhile leaves the page cached on its own, and its callers get it alone.
sub finishLink(context as object, settled as boolean)
    link = context.link
    if link = invalid then return
    context.link = invalid
    head = m.cache[link.headKey]
    if head = invalid or head.id <> link.headId then return
    head.nextPending = invalid
    if settled then linkPage(link.headKey, context.key)
end sub

' What a query answers with: the value, or for a query with pages every page loaded with the
' first page this key belongs to (the key itself, or the head it is linked to). An entry that
' went while its request ran still answers with the page it was asked for.
function answerFor(definition as object, key as string, value as dynamic) as dynamic
    if definition.pages = invalid then return value
    headKey = key
    entry = m.cache[key]
    if entry <> invalid and isNonEmptyString(entry.head) then headKey = entry.head
    pages = assemblePages(definition, headKey)
    if pages.pages.count() = 0 then return { pages: [value], hasNext: cursorOf(definition, value) <> invalid }
    return pages
end function

' Every page loaded for a head, in order, and whether the last one points to another
function assemblePages(definition as object, headKey as string) as object
    head = m.cache[headKey]
    if head = invalid or not head.hasValue then return { pages: [], hasNext: false }
    ' lastPage first: it drops the members that no longer follow, which are not read
    last = lastPage(head)
    pages = [head.value]
    for each key in head.chain
        pages.push(m.cache[key].value)
    end for
    return { pages: pages, hasNext: nextCursor(definition, last) <> invalid }
end function

' The last page in a head's chain, after dropping the chain from the first page that is no
' longer in memory (evicted): the pages after it would not follow from what is left. For a
' query paged by position, also from the first page that has expired (a write expires the
' listing): it was cut from the listing as it was, and nextPage reads it again
function lastPage(head as object) as object
    definition = m.definitions[head.name]
    byPosition = definition <> invalid and definition.pages <> invalid and definition.pages.byPosition
    for i = 0 to head.chain.count() - 1
        entry = m.cache[head.chain[i]]
        if entry = invalid or not entry.hasValue or (byPosition and entry.expired) then
            cutChain(head, i)
            exit for
        end if
    end for
    if head.chain.count() = 0 then return head
    return m.cache[head.chain.peek()]
end function

' Drops the members of a head's chain from index on
sub cutChain(head as object, index as integer)
    while head.chain.count() > index
        member = m.cache[head.chain.pop()]
        if member <> invalid then member.head = ""
    end while
end sub

sub linkPage(headKey as string, nextKey as string)
    head = m.cache[headKey]
    member = m.cache[nextKey]
    if head = invalid or member = invalid or headKey = nextKey then return
    for each key in head.chain
        if key = nextKey then return
    end for
    head.chain.push(nextKey)
    member.head = headKey
end sub

' A page that changed re-cuts the ones after it, which came from the old listing: the chain
' ends at this page (a changed first page keeps none)
sub resetPagesAfter(key as string, entry as object)
    if isNonEmptyString(entry.head) then
        head = m.cache[entry.head]
        if head = invalid then return
        for i = 0 to head.chain.count() - 1
            if head.chain[i] = key then
                cutChain(head, i + 1)
                return
            end if
        end for
    else
        cutChain(entry, 0)
    end if
end sub

' Takes an entry out of its chain, whichever end it is at
sub unlinkPage(key as string, entry as object)
    if isNonEmptyString(entry.head) then
        head = m.cache[entry.head]
        if head <> invalid then
            for i = 0 to head.chain.count() - 1
                if head.chain[i] = key then
                    cutChain(head, i)
                    exit for
                end if
            end for
        end if
        entry.head = ""
    end if
    cutChain(entry, 0)
end sub

' The keys of the pages after a head's, in order
function chainOf(key as string) as object
    entry = m.cache[key]
    if entry = invalid then return []
    keys = []
    keys.append(entry.chain)
    return keys
end function

' The cursor a page's value holds for the page after it, or invalid on the last page
function nextCursor(definition as object, entry as dynamic) as dynamic
    if entry = invalid or not entry.hasValue then return invalid
    return cursorOf(definition, entry.value)
end function

function cursorOf(definition as object, value as dynamic) as dynamic
    if definition.pages = invalid then return invalid
    ' The page says whether another follows: its cursor counts only when one does
    if definition.pages.hasNext <> invalid then
        follows = valueAtPath(value, definition.pages.hasNext)
        if type(follows) <> "roBoolean" and type(follows) <> "Boolean" then return invalid
        if not follows then return invalid
    end if
    cursor = valueAtPath(value, definition.pages.next)
    if cursor = invalid then return invalid
    if (type(cursor) = "roString" or type(cursor) = "String") and cursor = "" then return invalid
    if (type(cursor) = "roBoolean" or type(cursor) = "Boolean") and not cursor then return invalid
    return cursor
end function

' Follows a dotted path through associative arrays and node fields
function valueAtPath(value as dynamic, path as string) as dynamic
    current = value
    for each part in path.split(".")
        if type(current) = "roAssociativeArray" or type(current) = "roSGNode" then
            current = current[part]
        else
            return invalid
        end if
    end for
    return current
end function

' An entry with no value yet. args: what it was asked for with, to ask again (refresh).
' setId: which local write (set) put the value there, 0 for none
function newEntry(definition as object, now as integer, args as object) as object
    m.nextEntryId++
    return { id: m.nextEntryId, name: definition.name, args: args, scopes: definition.scopes, bucket: bucketOf(definition, now), hasValue: false, value: invalid, storedAt: 0, freshUntil: 0, hash: "", parsedHash: "", etag: "", lastModified: "", expired: false, expiredSequence: 0, chain: [], head: "", nextPending: invalid, fetch: invalid, setId: 0 }
end function

' Starts (or restarts) a fetch for a key. Returns the pending promise.
' When background is true an existing value stays served until the refresh lands.
' fallback: a failed request resolves with the kept value instead of rejecting (expired entries).
' skipDisk: go straight to the network even when memory has nothing (force).
function startFetch(definition as object, key as string, args as object, now as integer, background as boolean, fallback = false as boolean, skipDisk = false as boolean, priority = "" as string) as object
    if priority = "" then priority = background ? "low" : definition.priority
    entry = m.cache[key]
    if entry <> invalid and entry.promise <> invalid then
        if not background then
            if entry.fetch <> invalid then entry.fetch.waiters++
            promote(entry.fetch, priority)
        end if
        return entry.promise
    end if

    if entry = invalid then
        entry = newEntry(definition, now, args)
        insertEntry(key, entry)
    end if

    pending = promises.create()
    entry.promise = pending
    m.sequence++

    ' pending travels with the request: the entry may be dropped or expired before it answers,
    ' and its callers are owed an answer either way
    context = { key: key, definition: definition, args: args, pending: pending, entryId: entry.id, sequence: m.sequence, fallback: fallback, startedAt: createObject("roTimespan"), link: invalid, priority: priority, requestPromise: invalid, waiters: background ? 0 : 1 }
    ' nextPage finds the fetch it joins through the entry, to hand it the head to link to
    entry.fetch = context

    ' Disk first, when allowed and nothing is in memory yet. The read is asynchronous
    ' (task thread); a miss or a failure falls through to the network.
    if not background and not skipDisk and not entry.hasValue and definition.persist and isNode(diskTask()) then
        readPromise = m.persistence.callFunc("execute", { type: "read", path: persistPath(key) })
        promises.chain(readPromise, context).then(function(text as dynamic, context as object) as dynamic
            runCleanups()
            envelope = parseEnvelope(text, context.key)
            ' A copy stored before an expire() of this query is known to be out of date
            if envelope <> invalid and diskExpired(context, envelope.storedAt) then envelope = invalid
            if envelope <> invalid then
                ' A parser decodes the text on its own task; without one the value is the
                ' decoded body, as the transport would have made it
                context.decode = envelope.decode = true
                context.body = envelope.body
                if not isNonEmptyString(context.definition.parser) then context.body = decodeBody(envelope.body, context.decode)
            end if
            if envelope <> invalid then
                m.stats.diskHits++
                context.source = "disk"
                context.persistedAt = envelope.storedAt
                context.maxAge = envelope.maxAge
                context.hash = asString(envelope.hash)
                context.etag = asString(envelope.etag)
                context.lastModified = asString(envelope.lastModified)
                runParseStage(context)
            else
                startNetwork(context)
            end if
            return invalid
        end function).catch(function(error as dynamic, context as object) as dynamic
            runCleanups()
            startNetwork(context)
            return invalid
        end function).toPromise()
        return pending
    end if

    startNetwork(context)
    return pending
end function

' Issues the transport request for a context created by startFetch. A response whose
' body hashes the same as the cached value's (or a 304 to a conditional request) only
' renews the entry: no parse, no disk write, no change notification.
sub startNetwork(context as object)
    context.source = "network"
    client = clientOf(context.definition)
    if client = invalid then
        settleError(context, noClientError(context.definition))
        return
    end if
    m.stats.requests++
    client.requests++
    spec = buildRequestSpec(context.definition, context.args)
    spec.hashBody = true
    ' A parser's body comes back as text and is decoded on its task (see parseOnTask). Without
    ' a parser the body is decoded here, and a persisted one keeps its text for the disk too.
    context.decode = spec.parseJson
    if isNonEmptyString(context.definition.parser) then
        spec.parseJson = false
    else if context.definition.persist then
        spec.keepRawBody = true
    end if
    entry = m.cache[context.key]
    if context.definition.conditional and entry <> invalid and entry.hasValue then
        if entry.etag <> "" then spec.headers["If-None-Match"] = entry.etag
        if entry.lastModified <> "" then spec.headers["If-Modified-Since"] = entry.lastModified
        spec.allowNotModified = spec.headers.count() > 0
    end if
    spec.priority = context.priority

    promises.chain(sendRequest(client, spec, context), context).then(function(response as object, context as object) as dynamic
        context.response = response
        context.etag = headerValue(response.headers, "etag")
        context.lastModified = headerValue(response.headers, "last-modified")
        context.maxAge = cacheControlTtl(response.headers)
        entry = m.cache[context.key]
        hasValue = entry <> invalid and entry.hasValue
        if response.notModified = true then
            if hasValue then
                settleUnchanged(context)
            else
                settleError(context, { message: `sghttp: "${context.definition.name}" got 304 with nothing cached`, code: 304 })
            end if
            return invalid
        end if
        context.hash = asString(response.bodyHash)
        if hasValue and context.hash <> "" and context.hash = entry.hash then
            settleUnchanged(context)
            return invalid
        end if
        context.body = response.body
        ' Only an answer the entry will keep is stored: not one from before a drop or expire
        if context.definition.persist and currentEntry(context) <> invalid and not cacheControlNoStore(response.headers) then writePersisted(context.key, bodyText(response), context)
        runParseStage(context)
        return invalid
    end function).catch(function(error as dynamic, context as object) as dynamic
        settleError(context, error)
        return invalid
    end function).toPromise()
end sub

' Executes a cache: false definition. Parses if a parser is set, applies the
' definition's removals on success, and never touches the cache.
' raw: resolve with the whole response (its body parsed) rather than the value alone
function runUncached(definition as object, args as object, raw = false as boolean) as object
    pending = promises.create()
    context = { definition: definition, args: args, pending: pending, startedAt: createObject("roTimespan"), raw: raw }
    client = clientOf(definition)
    if client = invalid then
        m.stats.errors++
        emit("error", definition.name, "", "network", 0, errorDetails(definition, noClientError(definition)))
        promises.reject(noClientError(definition), pending)
        return pending
    end if
    m.stats.requests++
    client.requests++
    spec = buildRequestSpec(definition, args)
    ' A parser's body crosses to its task as text and is decoded there (see parseOnTask)
    context.decode = spec.parseJson
    if isNonEmptyString(definition.parser) then spec.parseJson = false
    ' Only a request that changes nothing can be abandoned once it is sent (see _cancel): a GET,
    ' a HEAD, or a cached query's request sent with fetch(name)
    method = ucase(spec.method)
    context.safeToAbort = method = "GET" or method = "HEAD" or spec.safeToRepeat = true
    context.cancelled = false
    m.calls[pending.id] = context

    promises.chain(sendRequest(client, spec, context), context).then(function(response as object, context as object) as dynamic
        if context.cancelled then return promises.reject(cancelledError())
        definition = context.definition
        context.response = response
        ' Partial data comes with the errors of the fields that failed: fetch hands them back
        if definition.graphql and type(response.body) = "roAssociativeArray" and type(response.body.errors) = "roArray" then context.response.errors = response.body.errors
        if isNonEmptyString(definition.parser) then
            if m.parsers.count() = 0 then
                return promises.reject({ message: `sghttp: query "${definition.name}" names parser "${definition.parser}" but no parserTask was configured` })
            end if
            return parseOnTask({ parser: definition.parser, body: response.body, args: context.args, decode: context.decode, graphql: definition.graphql })
        end if
        return graphqlData(definition, response.body)
    end function).then(function(value as dynamic, context as object) as dynamic
        if context.cancelled then return promises.reject(cancelledError())
        m.calls.delete(context.pending.id)
        applyRemovals(context.definition)
        emit("resolve", context.definition.name, "", "network", context.startedAt.totalMilliseconds(), { client: context.definition.client })
        if context.raw then
            context.response.body = value
            value = context.response
        end if
        promises.resolve(value, context.pending)
        return invalid
    end function).catch(function(error as dynamic, context as object) as dynamic
        m.calls.delete(context.pending.id)
        ' A cancel is the caller's choice, not a failure: no error event or count
        if context.cancelled or (type(error) = "roAssociativeArray" and error.cancelled = true) then
            emit("cancel", context.definition.name, "", "network", context.startedAt.totalMilliseconds())
            promises.reject(cancelledError(), context.pending)
            return invalid
        end if
        m.stats.errors++
        emit("error", context.definition.name, "", "network", context.startedAt.totalMilliseconds(), errorDetails(context.definition, error))
        promises.reject(error, context.pending)
        return invalid
    end function).toPromise()

    return pending
end function

' Sends a context's request through its client and returns a promise for its answer. A 401 to a
' request that sent the client's shared headers may be held and sent again with new ones (see
' holdUnauthorized), so the promise settles with the last answer. context.requestPromise is
' always the transport's promise for the request now out, for cancel and promote.
function sendRequest(client as object, spec as object, context as object) as object
    context.reply = promises.create()
    context.spec = spec
    context.resent = false
    transmit(client, context)
    return context.reply
end function

sub transmit(client as object, context as object)
    m.sendCount++
    context.sendNumber = m.sendCount
    context.requestPromise = client.transport.callFunc("makeRequest", context.spec)
    promises.chain(context.requestPromise, context).then(function(response as object, context as object) as dynamic
        promises.resolve(response, context.reply)
        return invalid
    end function).catch(function(error as dynamic, context as object) as dynamic
        if not holdUnauthorized(context, error) then promises.reject(error, context.reply)
        return invalid
    end function)
end sub

' A 401 to a request that sent the shared headers of a client the app renews (onUnauthorized).
' Sent before the headers were last renewed, it goes again at once. Otherwise it waits while the
' app renews them: the first such 401 sets the client's authWatcher, and every other request
' answered 401 meanwhile, sent before or during the renewal, joins it in held until _reauthorize.
' The renewing request itself must not wait on its own answer: it sends no shared headers
' (auth: false), so its 401 is never held. A request is held once at most, and sent again at
' once once at most, so a header that changed for another reason (setHeaders renews them all)
' still leads to a renewal. When the app could not renew (reauthorize(invalid)), a request sent
' before it answered fails as it is: the app is asked once per renewal, not once per request in
' flight. Returns whether the 401 was taken.
function holdUnauthorized(context as object, error as dynamic) as boolean
    if type(error) <> "roAssociativeArray" or error.code <> 401 then return false
    if context.wasHeld = true or context.definition.auth = false then return false
    client = clientOf(context.definition)
    if client = invalid or not isNode(client.authWatcher) then return false
    context.authError = error
    if client.renewing then
        hold(client, context)
        return true
    end if
    if context.sendNumber <= client.renewedAt and not context.resent then
        context.resent = true
        resend(client, context)
        return true
    end if
    if context.sendNumber <= client.deniedAt then return false
    client.renewing = true
    hold(client, context)
    client.authWatcher.unauthorized = { client: client.name, url: asString(error.url) }
    return true
end function

sub hold(client as object, context as object)
    context.wasHeld = true
    client.held.push(context)
end sub

sub resend(client as object, context as object)
    m.stats.requests++
    client.requests++
    ' The renewed headers travel with the request, so it never goes out ahead of the
    ' transport's copy of them
    headers = {}
    headers.append(client.headers)
    if type(context.spec.headers) = "roAssociativeArray" then headers.append(context.spec.headers)
    context.spec.headers = headers
    if isNonEmptyString(context.priority) then context.spec.priority = context.priority
    transmit(client, context)
end sub

' Takes a context out of its client's held requests; returns whether it was there
function releaseHeld(client as object, context as object) as boolean
    if not isNode(context.reply) then return false
    for i = 0 to client.held.count() - 1
        if client.held[i].reply.isSameNode(context.reply) then
            client.held.delete(i)
            return true
        end if
    end for
    return false
end function

sub applyRemovals(definition as object)
    for each target in definition.removes
        if isNonEmptyString(target) then _remove(target)
    end for
    for each target in definition.expires
        if isNonEmptyString(target) then
            _expire(target)
            ' The screens showing it get the server's word on the change without asking
            _refresh(target)
        end if
    end for
end sub

' The entry a request may still write to: the one it started for (not dropped and made again
' since) and not expired after the request started. invalid otherwise.
function currentEntry(context as object) as dynamic
    entry = m.cache[context.key]
    if entry = invalid or entry.id <> context.entryId then return invalid
    if context.sequence < entry.expiredSequence then return invalid
    return entry
end function

' The request is answered: the entry stops sharing its promise (if it still does)
sub releaseRequest(context as object)
    entry = m.cache[context.key]
    if entry <> invalid and isNode(entry.promise) and entry.promise.isSameNode(context.pending) then
        entry.promise = invalid
        entry.fetch = invalid
    end if
end sub

' Runs the optional parser, then stores and resolves.
sub runParseStage(context as object)
    definition = context.definition
    if isNonEmptyString(definition.parser) then
        if m.parsers.count() = 0 then
            settleError(context, { message: `sghttp: query "${definition.name}" names parser "${definition.parser}" but no parserTask was configured` })
            return
        end if
        hashResult = definition.compare = "parsed"
        parsePromise = parseOnTask({ parser: definition.parser, body: context.body, args: context.args, hashResult: hashResult, decode: context.decode = true, graphql: definition.graphql })
        promises.chain(parsePromise, context).then(function(parsed as dynamic, context as object) as dynamic
            if context.definition.compare = "parsed" and type(parsed) = "roAssociativeArray" then
                context.parsedHash = asString(parsed.hash)
                parsed = parsed.value
            end if
            settleValue(context, parsed)
            return invalid
        end function).catch(function(error as dynamic, context as object) as dynamic
            settleError(context, error)
            return invalid
        end function).toPromise()
    else
        settleValue(context, graphqlData(definition, context.body))
    end if
end sub

' Hands a job to the parser task with the fewest jobs waiting, so a small body (the menu) is
' not held behind a large one (a page of rows) while another task is free
function parseOnTask(job as object) as object
    index = 0
    for i = 1 to m.parsers.count() - 1
        if m.parsers[i].pending < m.parsers[index].pending then index = i
    end for
    worker = m.parsers[index]
    worker.pending++
    parsePromise = worker.node.callFunc("parse", job)
    ' Settled either way: the task has one job fewer
    promises.onThen(parsePromise, function(value as dynamic, worker as object) as dynamic
        worker.pending--
        return invalid
    end function, worker)
    promises.onCatch(parsePromise, function(error as dynamic, worker as object) as dynamic
        worker.pending--
        return invalid
    end function, worker)
    return parsePromise
end function

sub settleValue(context as object, value as dynamic)
    key = context.key
    definition = context.definition
    now = nowSeconds()
    releaseRequest(context)
    entry = currentEntry(context)

    if entry = invalid then
        ' Dropped or expired while in flight: the callers that asked get this answer, the
        ' cache keeps what it has
        emit("resolve", definition.name, key, context.source, context.startedAt.totalMilliseconds())
        finishLink(context, true)
        promises.resolve(answerFor(definition, key, value), context.pending)
        return
    end if

    ' compare: "parsed": the bytes differed but what the app sees did not (volatile
    ' fields the parser drops), so keep the value it already has
    parsedHash = asString(context.parsedHash)
    if entry.hasValue and definition.compare = "parsed" and parsedHash <> "" and parsedHash = entry.parsedHash then
        settleUnchanged(context)
        return
    end if
    ' Replacing a value with different content is a change; a first value is not
    ' (whoever fetched it receives it through the promise)
    replaced = entry.hasValue and (entry.hash = "" or asString(context.hash) = "" or entry.hash <> context.hash)
    ' A page whose cursor to the next page is the same still heads the same listing
    recut = replaced and definition.pages <> invalid and asString(nextCursor(definition, entry)) <> asString(cursorOf(definition, value))
    entry.value = value
    entry.hasValue = true
    entry.expired = false
    ' A server value is newer than any local write, so a failed mutation's rollback leaves it
    entry.setId = 0
    entry.hash = asString(context.hash)
    entry.parsedHash = parsedHash
    entry.etag = asString(context.etag)
    entry.lastModified = asString(context.lastModified)
    entry.storedAt = now
    ttl = ttlFor(definition, context)
    if context.source = "disk" and (type(context.persistedAt) = "roInt" or type(context.persistedAt) = "roInteger") then
        ' A disk value counts as stored when it was fetched, so it may already be stale
        entry.storedAt = context.persistedAt
    end if
    entry.freshUntil = (ttl < 0) ? 2147483647 : entry.storedAt + ttl
    emit("resolve", definition.name, key, context.source, context.startedAt.totalMilliseconds())
    ' The listing is re-cut before anyone is answered with it
    if recut then resetPagesAfter(key, entry)
    finishLink(context, true)
    promises.resolve(answerFor(definition, key, value), context.pending)
    if replaced then
        if definition.pages <> invalid then
            ' Watchers of a query with pages hear about its first page's key, with every page
            headKey = isNonEmptyString(entry.head) ? entry.head : key
            notifyChange(definition.name, headKey, context.source, assemblePages(definition, headKey))
        else
            notifyChange(definition.name, key, context.source, value)
        end if
    end if

    ' A stale disk value is served now and refreshed in the background
    if context.source = "disk" and now >= entry.freshUntil and definition.staleWhileRevalidate then
        startFetch(definition, key, context.args, now, true)
    end if
end sub

' The server's copy matches the cached value: renew its freshness and resolve with it.
' New validators (a 304 or 200 may carry a new etag) replace the old ones.
sub settleUnchanged(context as object)
    key = context.key
    releaseRequest(context)
    kept = m.cache[key]
    entry = currentEntry(context)
    if entry = invalid then
        ' From before a drop or expire: its callers get the value it matched, nothing is renewed
        keptValue = invalid
        if kept <> invalid then keptValue = kept.value
        finishLink(context, true)
        promises.resolve(answerFor(context.definition, key, keptValue), context.pending)
        return
    end if
    definition = context.definition
    entry.expired = false
    ' A body that parsed the same still has new bytes: remember them so the next
    ' identical response is settled before parsing
    if asString(context.hash) <> "" then entry.hash = context.hash
    if asString(context.etag) <> "" then entry.etag = context.etag
    if asString(context.lastModified) <> "" then entry.lastModified = context.lastModified
    entry.storedAt = nowSeconds()
    ttl = ttlFor(definition, context)
    entry.freshUntil = (ttl < 0) ? 2147483647 : entry.storedAt + ttl
    m.stats.unchanged++
    emit("unchanged", definition.name, key, context.source, context.startedAt.totalMilliseconds())
    finishLink(context, true)
    promises.resolve(answerFor(definition, key, entry.value), context.pending)
end sub

sub settleError(context as object, error as dynamic)
    key = context.key
    releaseRequest(context)
    m.stats.errors++
    emit("error", context.definition.name, key, context.source, context.startedAt.totalMilliseconds(), errorDetails(context.definition, error))
    ' Keep a previously good value (background refresh failed); drop an empty entry so the next call retries
    entry = currentEntry(context)
    if entry <> invalid and not entry.hasValue then removeEntry(key)
    ' An expired value is still the best answer when the server cannot give a newer one
    kept = m.cache[key]
    if context.fallback = true and kept <> invalid and kept.hasValue then
        finishLink(context, true)
        promises.resolve(answerFor(context.definition, key, kept.value), context.pending)
    else
        finishLink(context, false)
        promises.reject(error, context.pending)
    end if
end sub

' A cached value was replaced by different content: the store's `changed` field, and every
' watcher of this query whose args key to it now (or that watches every entry)
sub notifyChange(name as string, key as string, source as string, value as dynamic)
    m.stats.changes++
    if m.debug then print `[sghttp] change ${name} via ${source} ${key}`
    m.top.changed = { name: name, key: key, source: source }
    watchers = m.watchers[name]
    if watchers = invalid then return
    ' A copy: a watcher's callback may unwatch
    for each watcher in copyOf(watchers)
        if watcher.args = invalid or _keyFor(name, watcher.args) = key then
            watcher.node.changed = { name: name, key: key, source: source, value: value }
        end if
    end for
end sub

function copyOf(items as object) as object
    copy = []
    copy.append(items)
    return copy
end function

' Resolves the request template against args/scopes for the transport.
function buildRequestSpec(definition as object, args as object) as object
    request = definition.request
    ' A page after the first (its args carry the cursor) may have a request of its own
    if definition.pages <> invalid and definition.pages.request <> invalid and args[definition.pages.arg] <> invalid then request = definition.pages.request
    if type(request) <> "roAssociativeArray" then request = {}
    spec = {
        url: fillTemplate(isNonEmptyString(request.url) ? request.url : "", args, m.scopes)
        method: isNonEmptyString(request.method) ? request.method : "GET"
        headers: {}
        body: request.body
        query: request.query
        parseJson: request.parseJson <> false
        successCodes: definition.successCodes
        retries: request.retries
        timeoutSeconds: definition.timeout
        includeSharedHeaders: definition.auth
        useProxy: definition.proxy
        priority: definition.priority
        ' A cached query reads, whatever its method (a search sent as a POST), and so does a
        ' GraphQL query, cached or not: the transport retries it as it would a GET
        safeToRepeat: definition.cache or (definition.graphql = true and not definition.graphqlMutation)
    }
    if type(spec.headers) <> "roAssociativeArray" then spec.headers = {}
    ' A fetch that downloads: the body goes to the file, not to the caller
    if isNonEmptyString(definition.toFile) then
        spec.toFile = fillTemplate(definition.toFile, args, m.scopes)
        spec.parseJson = false
    end if
    ' An unfilled path placeholder still reaches some other route on the server, with a
    ' body that parses as nothing; say so instead of failing quietly.
    if createObject("roRegex", "\{[A-Za-z0-9_]+\}", "").isMatch(spec.url) then
        print `[sghttp] "${definition.name}" url has an unfilled placeholder: ${spec.url}`
    end if
    if type(request.headers) = "roAssociativeArray" then
        for each headerName in request.headers
            spec.headers[headerName] = fillTemplate(request.headers[headerName].toStr(), args, m.scopes)
        end for
    end if
    if type(spec.query) = "roAssociativeArray" then
        filled = {}
        unfilled = createObject("roRegex", "\{[A-Za-z0-9_]+\}", "")
        wholePlaceholder = createObject("roRegex", "^\{([A-Za-z0-9_]+)\}$", "")
        for each queryName in spec.query
            rawValue = spec.query[queryName]
            if type(rawValue) = "roArray" then
                ' Repeated parameter (?slug=a&slug=b); array values are passed through as-is
                filled[queryName] = rawValue
            else if rawValue <> invalid then
                template = rawValue.toStr()
                whole = wholePlaceholder.match(template)
                if whole.count() = 2 and type(args[whole[1]]) = "roArray" then
                    ' A value of exactly "{name}" takes an array arg as a repeated parameter
                    if args[whole[1]].count() > 0 then filled[queryName] = args[whole[1]]
                    continue for
                end if
                value = fillTemplate(template, args, m.scopes)
                ' A placeholder that found no arg or scope, or filled to an empty value,
                ' drops the parameter entirely (e.g. an optional profile id).
                ' Fixed text in the definition is always sent.
                fromPlaceholder = unfilled.isMatch(template)
                if not unfilled.isMatch(value) and not (fromPlaceholder and value = "") then filled[queryName] = value
            end if
        end for
        spec.query = filled
    end if
    if type(spec.body) = "roString" or type(spec.body) = "String" then
        ' A body of exactly "{name}" passes args.name through untouched (objects and arrays included)
        whole = createObject("roRegex", "^\{([A-Za-z0-9_]+)\}$", "").match(spec.body)
        if whole.count() = 2 and args[whole[1]] <> invalid then
            spec.body = args[whole[1]]
        else
            spec.body = fillTemplate(spec.body, args, m.scopes)
        end if
    else if type(spec.body) = "roAssociativeArray" then
        filledBody = {}
        for each bodyKey in spec.body
            bodyValue = spec.body[bodyKey]
            if type(bodyValue) = "roString" or type(bodyValue) = "String" then
                filledBody[bodyKey] = fillTemplate(bodyValue, args, m.scopes)
            else
                filledBody[bodyKey] = bodyValue
            end if
        end for
        spec.body = filledBody
    end if
    if type(request.graphql) = "roAssociativeArray" then
        ' GraphQL: the operation goes as JSON, in a POST unless the request names a method. Its
        ' text is never a template, since a selection set such as {slug} reads as a placeholder;
        ' only variables are filled.
        if not isNonEmptyString(request.method) then spec.method = "POST"
        body = {}
        body.setModeCaseSensitive()
        body["query"] = request.graphql.query
        if request.graphql.variables <> invalid then body["variables"] = fillVariables(request.graphql.variables, args)
        if isNonEmptyString(request.graphql.operationName) then body["operationName"] = request.graphql.operationName
        spec.body = body
        spec.graphql = true
    end if
    return spec
end function

'#endregion

'*************************************************************************
'#region Removal and eviction
'*************************************************************************

' GraphQL variables with values of exactly "{name}" taken from args, then scopes, as they are:
' a number stays a number, an object an object. Other strings are filled as text, and nested
' objects and arrays the same way. A "{name}" with no arg or scope is left out, so the server
' sees the variable as null.
function fillVariables(value as dynamic, args as object) as dynamic
    valueType = type(value)
    if valueType = "roAssociativeArray" then
        filled = {}
        filled.setModeCaseSensitive()
        for each key in value
            item = fillVariables(value[key], args)
            if item <> invalid then filled[key] = item
        end for
        return filled
    end if
    if valueType = "roArray" then
        filled = []
        for each item in value
            filled.push(fillVariables(item, args))
        end for
        return filled
    end if
    if valueType <> "roString" and valueType <> "String" then return value
    whole = createObject("roRegex", "^\{([A-Za-z0-9_]+)\}$", "").match(value)
    if whole.count() <> 2 then return fillTemplate(value, args, m.scopes)
    name = whole[1]
    if type(args) = "roAssociativeArray" and args[name] <> invalid then return args[name]
    return m.scopes[name]
end function

' Whether a GraphQL document's operation is a mutation: its keyword is read at the top level
' only (outside braces, strings and comments), so a field named mutation never counts
function hasGraphql(request as dynamic) as boolean
    return type(request) = "roAssociativeArray" and type(request.graphql) = "roAssociativeArray"
end function

' Whether a GraphQL document's operation is a mutation: the operation operationName names, when
' it is given and found in the document, else any top-level mutation in it. Only the top level
' is read, outside strings and comments, so a field or argument called mutation is not one.
function isGraphqlMutation(document as dynamic, operationName = "" as string) as boolean
    if not isNonEmptyString(document) then return false
    nameChars = createObject("roRegex", "[A-Za-z0-9_$]", "")
    operations = []
    naming = false   ' the last word was an operation keyword: a name may follow
    depth = 0
    word = ""
    inString = false
    inComment = false
    escaped = false
    document = document + " "   ' so the last word is handled in the loop
    for i = 0 to document.len() - 1
        c = document.mid(i, 1)
        if depth = 0 and not inString and not inComment and nameChars.isMatch(c) then
            word = word + c
        else
            if word <> "" then
                if word = "query" or word = "mutation" or word = "subscription" then
                    operations.push({ type: word, name: "" })
                    naming = true
                else if naming then
                    operations.peek().name = word
                    naming = false
                end if
                word = ""
            end if
            if inComment then
                if c = chr(10) or c = chr(13) then inComment = false
            else if inString then
                if escaped then
                    escaped = false
                else if c = "\" then
                    escaped = true
                else if c = chr(34) then
                    inString = false
                end if
            else
                if c = "#" then
                    inComment = true
                else if c = chr(34) then
                    inString = true
                else if c = "{" then
                    depth++
                else if c = "}" then
                    depth--
                end if
                ' Anything but whitespace after the keyword: the operation has no name
                if naming and c <> " " and c <> "," and c <> chr(9) and c <> chr(10) and c <> chr(13) then naming = false
            end if
        end if
    end for
    if operationName <> "" then
        for each operation in operations
            if operation.name = operationName then return operation.type = "mutation"
        end for
    end if
    for each operation in operations
        if operation.type = "mutation" then return true
    end for
    return false
end function

' What a GraphQL query resolves with: the response's data. A response with errors and no data
' has already failed in the transport.
function graphqlData(definition as object, body as dynamic) as dynamic
    if definition.graphql = true and type(body) = "roAssociativeArray" and body.doesExist("data") then return body.data
    return body
end function

sub _remove(name = invalid as dynamic, args = invalid as dynamic)
    if name = invalid then
        for each key in m.cache.keys()
            removeEntry(key)
        end for
        clearPersisted()
        m.expiries = {}
        return
    end if

    if args = invalid then
        ' Matches the query itself ("favorites|...") and any dotted descendants ("favorites.check|...")
        exact = name + "|"
        group = name + "."
        for each key in m.cache.keys()
            if key.left(exact.len()) = exact or key.left(group.len()) = group then removeEntry(key)
        end for
        ' Disk copies not in memory (evicted, or from an earlier run) go too, and with them
        ' the expiry records that guarded them
        clearPersistedQuery(name, true)
        dropExpiries(name)
        return
    end if

    definition = m.definitions[name]
    if definition <> invalid then
        key = buildKey(name, definition, args, m.scopes, nowSeconds())
        ' The pages loaded after this one go with it
        for each memberKey in chainOf(key)
            removeEntry(memberKey)
        end for
        removeEntry(key)
    end if
end sub

' Every cached value becomes stale (kept, served, revalidated on its next fetch): the app
' was away long enough that anything may have changed
sub _expireAll()
    for each key in m.cache
        entry = m.cache[key]
        if entry <> invalid and entry.hasValue then entry.freshUntil = 0
    end for
end sub

' The app knows this data changed (it just wrote it): every matching entry keeps its value
' (peek and revalidate fetches still get it) but a plain fetch waits for the server, and a
' disk copy stored before now is not served. Name only: the query and its dotted
' descendants, like remove. A request already in flight may hold the old answer: it
' still answers its callers but is no longer shared or stored.
sub _expire(name as string, args = invalid as dynamic)
    if not isNonEmptyString(name) then return
    m.sequence++
    now = nowSeconds()
    if args = invalid then
        ' Supersedes every record for the query's keys and dotted descendants
        dropExpiries(name)
        m.expiries[name] = now
        exact = name + "|"
        group = name + "."
        for each key in m.cache
            if key.left(exact.len()) = exact or key.left(group.len()) = group then expireEntry(key)
        end for
        return
    end if
    definition = m.definitions[name]
    if definition = invalid then return
    if type(args) <> "roAssociativeArray" then args = {}
    key = buildKey(name, definition, args, m.scopes, now)
    ' Only a disk copy can outlive the entry; without one there is nothing to guard
    if definition.persist then m.expiries[key] = now
    expireEntry(key)
    ' The pages loaded after this one are as old as it
    for each memberKey in chainOf(key)
        if definition.persist then m.expiries[memberKey] = now
        expireEntry(memberKey)
    end for
end sub

sub expireEntry(key as string)
    entry = m.cache[key]
    if entry = invalid then return
    entry.expired = true
    entry.freshUntil = 0
    entry.expiredSequence = m.sequence
    entry.promise = invalid
    entry.fetch = invalid
end sub

' Whether a disk copy stored at storedAt predates an expire() of its key, its query or a
' dotted parent of the query
function diskExpired(context as object, storedAt as dynamic) as boolean
    if m.expiries.count() = 0 then return false
    name = context.definition.name
    candidates = [context.key, name]
    parts = name.split(".")
    prefix = ""
    for i = 0 to parts.count() - 2
        if i = 0 then prefix = parts[0] else prefix = prefix + "." + parts[i]
        candidates.push(prefix)
    end for
    latest = 0
    for each candidate in candidates
        at = m.expiries[candidate]
        if at <> invalid and at > latest then latest = at
    end for
    if latest = 0 then return false
    if type(storedAt) <> "roInt" and type(storedAt) <> "roInteger" and type(storedAt) <> "Integer" then return true
    return storedAt <= latest
end function

' Drops the expiry records of a query, its keys and its dotted descendants
sub dropExpiries(name as string)
    exact = name + "|"
    group = name + "."
    for each record in m.expiries.keys()
        if record = name or record.left(exact.len()) = exact or record.left(group.len()) = group then m.expiries.delete(record)
    end for
end sub

'*************************************************************************
'#region Time buckets
'*************************************************************************

' The time bucket a key for this definition is made in now, or -1 when it has no bucket
function bucketOf(definition as object, now as integer) as integer
    if isWholeNumber(definition.bucket) and definition.bucket > 0 then return now \ definition.bucket
    return -1
end function

' Once a bucket query rolls over, its keys from earlier buckets can never be fetched again:
' drop them (and their disk copies) instead of waiting for eviction. Runs once per rollover;
' an entry still in flight is left for the next one.
sub dropOldBuckets(definition as object, now as integer)
    current = bucketOf(definition, now)
    if current < 0 then return
    swept = m.buckets[definition.name]
    if swept <> invalid and swept = current then return
    m.buckets[definition.name] = current
    for each key in m.cache.keys()
        entry = m.cache[key]
        if entry <> invalid and entry.name = definition.name and entry.bucket >= 0 and entry.bucket < current and entry.promise = invalid then removeEntry(key)
    end for
end sub

'#endregion

'*************************************************************************
'#region Watchers
'*************************************************************************

' watcher: a node with an assocarray `changed` field, set to { name, key, source, value }
' when a value of this query is replaced by different content. args invalid: every entry of
' the query; args: the entry they key to at the time of the change.
sub _watch(name as string, args as dynamic, watcher as object)
    if not isNonEmptyString(name) or not isNode(watcher) then return
    watchers = m.watchers[name]
    if watchers = invalid then
        watchers = []
        m.watchers[name] = watchers
    end if
    if type(args) <> "roAssociativeArray" then args = invalid
    watchers.push({ node: watcher, args: args })
end sub

sub _unwatch(watcher as object)
    if not isNode(watcher) then return
    for each name in m.watchers.keys()
        watchers = m.watchers[name]
        for i = watchers.count() - 1 to 0 step -1
            if watchers[i].node.isSameNode(watcher) then watchers.delete(i)
        end for
        if watchers.count() = 0 then m.watchers.delete(name)
    end for
end sub

' Asks the server again, now, for every entry of the query (and its dotted descendants) that
' has a watcher; with args, that one entry when it is watched; with no name, every watched
' entry. Each keeps serving its value meanwhile, and a different answer reaches its watchers
' (see watch). Entries nobody watches are left as they are: revalidate is for one of those.
' Resolves once every refresh has settled, with the number started.
function _refresh(name = invalid as dynamic, args = invalid as dynamic) as object
    started = []
    now = nowSeconds()
    targetKey = ""
    if isNonEmptyString(name) and type(args) = "roAssociativeArray" then
        definition = m.definitions[name]
        if definition = invalid then return promises.resolve(0)
        targetKey = buildKey(name, definition, args, m.scopes, now)
    end if
    for each key in m.cache.keys()
        entry = m.cache[key]
        if entry = invalid or not entry.hasValue or entry.promise <> invalid then continue for
        ' A page after the first follows its listing's first page
        if isNonEmptyString(entry.head) then continue for
        if targetKey <> "" then
            if key <> targetKey then continue for
        else if isNonEmptyString(name) and not keyIsOf(key, name) then
            continue for
        end if
        definition = m.definitions[entry.name]
        if definition = invalid or not isWatched(entry.name, key) then continue for
        started.push(startFetch(definition, key, entry.args, now, true))
    end for
    return promises.chain(promises.allSettled(started)).then(function(results as dynamic) as dynamic
        return results.count()
    end function).toPromise()
end function

' Whether a key belongs to the query, or to one of its dotted descendants
function keyIsOf(key as string, name as string) as boolean
    exact = name + "|"
    group = name + "."
    return key.left(exact.len()) = exact or key.left(group.len()) = group
end function

' Whether any watcher of the query covers this key
function isWatched(name as string, key as string) as boolean
    watchers = m.watchers[name]
    if watchers = invalid then return false
    for each watcher in watchers
        if watcher.args = invalid or _keyFor(name, watcher.args) = key then return true
    end for
    return false
end function

'#endregion

sub _removeScope(scopeName as string)
    ' Disk copies not in memory go too: every stored body of a query that lists the scope
    for each name in m.definitions
        for each definitionScope in m.definitions[name].scopes
            if definitionScope = scopeName then
                clearPersistedQuery(name, false)
                exit for
            end if
        end for
    end for
    for each key in m.cache.keys()
        entry = m.cache[key]
        if entry <> invalid then
            for each entryScope in entry.scopes
                if entryScope = scopeName then
                    removeEntry(key)
                    exit for
                end if
            end for
        end if
    end for
end sub

' m.order runs from least to most recently used: a new entry goes to the back, and so does
' one served from memory (touch)
sub touch(key as string)
    last = m.order.count() - 1
    if last >= 0 and m.order[last] = key then return
    for i = 0 to last
        if m.order[i] = key then
            m.order.delete(i)
            m.order.push(key)
            return
        end if
    end for
end sub

sub insertEntry(key as string, entry as object)
    m.cache[key] = entry
    m.order.push(key)
    ' Evict the least recently used first, skipping in-flight entries. Scan at most one pass
    ' so a cache made entirely of in-flight entries can temporarily exceed the cap. Only the
    ' memory copy goes: a persisted body stays on cachefs for the next cold start (the OS
    ' manages cachefs space; remove still deletes it).
    scanned = 0
    limit = m.order.count()
    while m.order.count() > m.maxEntries and scanned < limit
        scanned++
        oldest = m.order.shift()
        oldestEntry = m.cache[oldest]
        if oldestEntry <> invalid and oldestEntry.promise <> invalid then
            m.order.push(oldest)
        else
            m.cache.delete(oldest)
        end if
    end while
end sub

' Drops the entry and its disk copy; the disk copy even when the entry is not in memory
' (evicted, or stored by an earlier run)
sub removeEntry(key as string)
    deletePersisted(key)
    m.expiries.delete(key)
    entry = m.cache[key]
    if entry = invalid then return
    unlinkPage(key, entry)
    m.cache.delete(key)
    for i = 0 to m.order.count() - 1
        if m.order[i] = key then
            m.order.delete(i)
            exit for
        end if
    end for
end sub

'#endregion

'*************************************************************************
'#region Persistence (cachefs:/)
'*************************************************************************

' The file for a key: in its query's directory (so remove can find bodies that are not in
' memory), named <prefix>-<digest of the key>.json. The prefix stands for the cache version and
' the query's request digest, so a changed url or parser retires the old bodies on its own, and
' the sweep can tell them by name.
function persistPath(key as string) as string
    name = key.split("|")[0]
    return m.persistDir + "/" + persistDirName(name) + "/" + filePrefix(name) + "-" + hashString(key) + ".json"
end function

' The start of the name of every file a query's bodies are stored in now
function filePrefix(name as string) as string
    definition = m.definitions[name]
    requestHash = ""
    if definition <> invalid then requestHash = asString(definition.requestHash)
    return hashString(m.version + "|" + requestHash).left(8)
end function

' For the sweep: each defined query's directory, with the file name prefixes stored there now
' (none for a query that is not persisted). Directories of queries not defined yet are not
' listed, so the sweep leaves them alone.
function sweepPlan() as object
    keep = {}
    for each name in m.definitions
        definition = m.definitions[name]
        dirName = persistDirName(name)
        if keep[dirName] = invalid then keep[dirName] = []
        if definition.persist then keep[dirName].push(filePrefix(name) + "-")
    end for
    return keep
end function

' The folder name for this app's bodies: params.namespace when given, else the channel id,
' title and version (<id>_<title>-<hash>_<version>). The id alone is "dev" for every sideloaded
' app; the title tells them apart, and the hash of the raw id and title keeps two titles that
' sanitize alike ("My App", "My-App") apart. The version gives each release a fresh disk cache.
' Sets m.appPrefix (<id>_<title>-<hash>_) for clearing the app's other versions.
' params.appInfo ({ id, title, version }) stands in for roAppInfo in tests.
function persistNamespace(params as object) as string
    if isNonEmptyString(params.namespace) then
        m.appPrefix = ""
        return namespacePart(params.namespace)
    end if
    info = params.appInfo
    if type(info) <> "roAssociativeArray" then
        appInfo = createObject("roAppInfo")
        info = { id: appInfo.getID(), title: appInfo.getTitle(), version: appInfo.getVersion() }
    end if
    id = asString(info.id)
    title = asString(info.title)
    m.appPrefix = namespacePart(id) + "_" + namespacePart(title) + "-" + hashString(id + "|" + title).left(8) + "_"
    return m.appPrefix + namespacePart(asString(info.version))
end function

' One part of the namespace: never holds the "_" that separates the parts, so an app titled
' "fc_x" cannot match the prefix of one titled "fc"
function namespacePart(text as string) as string
    return safeName(text, false)
end function

' A query's directory name. Keeps "_" so dotted descendants (favorites.check) stay findable
' by prefix
function persistDirName(name as string) as string
    return safeName(name, true)
end function

' text as a file name: letters, digits, "." and "-" stay; "_" stays only when allowed; anything
' else becomes the replacement ("_" when allowed, else "-"). Never empty.
function safeName(text as string, allowUnderscore as boolean) as string
    replacement = allowUnderscore ? "_" : "-"
    pattern = allowUnderscore ? "[^A-Za-z0-9._-]" : "[^A-Za-z0-9.-]"
    name = createObject("roRegex", pattern, "").replaceAll(text, replacement)
    if name = "" then name = replacement
    return name
end function

' The start-up clean-ups, once the first disk read has answered: the OS may be slow to delete
' many files, and a cold start should not wait on it. The last one sweeps out the bodies no
' definition defined by then can read.
sub runCleanups()
    if type(m.cleanups) <> "roArray" or not isNode(m.persistence) then return
    m.cleanups.push({ type: "sweep", dir: m.persistDir, keep: sweepPlan() })
    for each op in m.cleanups
        m.persistence.callFunc("execute", op)
    end for
    m.cleanups = invalid
end sub

' The request digest of the query a key belongs to (the key starts with the query's name)
function requestHashOf(key as string) as string
    definition = m.definitions[key.split("|")[0]]
    if definition = invalid then return ""
    return asString(definition.requestHash)
end function

' The response body as the text the server sent: the transport's copy of it, or the body
' itself when it was never decoded. A decoded body without its text (a replacement transport)
' is encoded again.
function bodyText(response as object) as dynamic
    if isNonEmptyString(response.rawBody) then return response.rawBody
    body = response.body
    if type(body) = "roString" or type(body) = "String" then return body
    if body = invalid then return invalid
    return formatJson(body)
end function

' The body as the transport would have made it: decoded when it is JSON and decode is true
function decodeBody(text as dynamic, decode as boolean) as dynamic
    if not decode or not isNonEmptyString(text) then return text
    decoded = parseJson(text)
    if decoded = invalid then return text
    return decoded
end function

' meta: { hash, etag, lastModified, decode } kept beside the body so a cold start can still
' tell an unchanged response and send the validators
sub writePersisted(key as string, body as dynamic, meta = {} as object)
    if not isNonEmptyString(body) or not isNode(diskTask()) then return
    header = { format: ENVELOPE_FORMAT, version: m.version, request: requestHashOf(key), key: key, storedAt: nowSeconds(), hash: asString(meta.hash), etag: asString(meta.etag), lastModified: asString(meta.lastModified), decode: meta.decode <> false, maxAge: isWholeNumber(meta.maxAge) ? meta.maxAge : -1 }
    text = formatJson(header) + chr(10) + body
    if text <> "" then
        m.persistence.callFunc("execute", { type: "write", path: persistPath(key), text: text })
        ' The copy on disk is now newer than any expire of this key
        m.expiries.delete(key)
    end if
end sub

' Validates the text read from disk. Returns its first line's fields with body set to the
' body's text, or invalid (and deletes a file in another format, written by another cache
' version, under another request, or for another key).
function parseEnvelope(text as dynamic, key as string) as dynamic
    if not isNonEmptyString(text) then return invalid
    newline = text.instr(chr(10))
    envelope = invalid
    if newline > 0 then envelope = parseJson(text.left(newline))
    if type(envelope) <> "roAssociativeArray" or envelope.format <> ENVELOPE_FORMAT or envelope.version <> m.version or envelope.request <> requestHashOf(key) or envelope.key <> key then
        deletePersisted(key)
        return invalid
    end if
    envelope.body = text.mid(newline + 1)
    return envelope
end function

' The persistence task, started now if this is the first call that needs the disk; invalid when
' persistence is off. Deleting a key's or a query's copies (deletePersisted, clearPersistedQuery)
' goes through a running task only: a query that persists starts it when it is defined, so a
' task that is not running has nothing on disk to delete from this run, and a copy from an
' earlier run is checked when its query next reads the disk. Clearing everything (clearPersisted,
' for a sign-out) starts it if need be, so copies of queries that no longer persist go too.
function diskTask() as dynamic
    if isNode(m.persistence) or not m.persistEnabled then return m.persistence
    if isNode(m.givenPersistence) then
        m.persistence = m.givenPersistence
    else
        m.persistence = createObject("roSGNode", "Persistence")
        m.ownsPersistence = true
    end if
    m.persistence.callFunc("execute", { type: "ensureDir", dir: PERSIST_DIR })
    m.persistence.callFunc("execute", { type: "ensureDir", dir: m.persistDir })
    return m.persistence
end function

sub deletePersisted(key as string)
    if isNode(m.persistence) then m.persistence.callFunc("execute", { type: "delete", path: persistPath(key) })
end sub

sub clearPersisted()
    if isNode(diskTask()) then m.persistence.callFunc("execute", { type: "clear", dir: m.persistDir })
end sub

' Deletes every stored body of a query, and of its dotted descendants when descendants is true
sub clearPersistedQuery(name as string, descendants as boolean)
    if isNode(m.persistence) then m.persistence.callFunc("execute", { type: "clearQuery", dir: m.persistDir, name: persistDirName(name), descendants: descendants })
end sub

'#endregion

' How long a value stays fresh: the definition's ttl when it gives one, else what the
' response's Cache-Control asked for (kept with a disk copy), else the store default
function ttlFor(definition as object, context as object) as integer
    if definition.ttlGiven then return definition.ttl
    if isWholeNumber(context.maxAge) and context.maxAge >= 0 then return context.maxAge
    return definition.ttl
end function

' The freshness a response's Cache-Control asks for, in seconds: max-age less the Age the
' response already has, or 0 for no-cache. -1 when the header says nothing usable.
function cacheControlTtl(headers as dynamic) as integer
    control = lcase(headerValue(headers, "cache-control"))
    if control = "" then return -1
    if control.instr("no-cache") >= 0 then return 0
    match = createObject("roRegex", "(?:^|[,\s])max-age=(\d+)", "").match(control)
    if match.count() < 2 then return -1
    ttl = match[1].toInt()
    age = headerValue(headers, "age").trim()
    if createObject("roRegex", "^\d+$", "").isMatch(age) then ttl = ttl - age.toInt()
    if ttl < 0 then ttl = 0
    return ttl
end function

' Whether the response's Cache-Control forbids keeping it on disk
function cacheControlNoStore(headers as dynamic) as boolean
    return lcase(headerValue(headers, "cache-control")).instr("no-store") >= 0
end function

' A response header by name, whatever case the server sent it in
function headerValue(headers as dynamic, name as string) as string
    if type(headers) <> "roAssociativeArray" then return ""
    for each headerName in headers
        if lcase(headerName) = name then return asString(headers[headerName])
    end for
    return ""
end function

function asString(value as dynamic) as string
    if value = invalid then return ""
    if type(value) = "roString" or type(value) = "String" then return value
    return ""
end function

' The cache key a fetch with these args would use now
function _keyFor(name as string, args = {} as object) as string
    definition = m.definitions[name]
    if definition = invalid then return ""
    if type(args) <> "roAssociativeArray" then args = {}
    return buildKey(name, definition, args, m.scopes, nowSeconds())
end function

' Every event names the client its query belongs to ("default" for the top-level one), so
' an app can react to one server's auth failures without guessing from query names
' extra.client names the client when the name is not a definition's (an ad-hoc request)
sub emit(eventType as string, name as string, key as string, source as string, ms as integer, extra = invalid as dynamic)
    clientName = DEFAULT_CLIENT
    definition = m.definitions[name]
    if definition <> invalid then clientName = definition.client
    event = { type: eventType, name: name, key: key, source: source, ms: ms, client: clientName }
    if type(extra) = "roAssociativeArray" then event.append(extra)
    if eventType = "error" then
        client = m.clients[event.client]
        if client <> invalid then client.errors++
    end if
    m.top.lastEvent = event
    if m.debug then print `[sghttp] ${eventType} ${name} via ${source} (${ms}ms)${eventType = "error" ? " code " + asString(event.code) : ""} ${key}`
end sub

' Error events carry the HTTP status (0 for network or parse failures) and whether the
' request sent the shared headers, so the app can react to auth failures (401) globally.
function errorDetails(definition as object, error as dynamic) as object
    code = 0
    if type(error) = "roAssociativeArray" and error.code <> invalid then code = error.code
    return { code: code, auth: definition.auth <> false, client: definition.client }
end function

sub _destroy()
    for each key in m.cache.keys()
        m.cache.delete(key)
    end for
    m.order = []
    m.watchers = {}
    m.expiries = {}
    m.buckets = {}
    m.calls = {}
    for each clientName in m.clients
        transport = m.clients[clientName].transport
        if transport.hasField("shutdown") then transport.shutdown = true
    end for
    m.clients = {}
    for each worker in m.parsers
        if worker.node.hasField("shutdown") then worker.node.shutdown = true
    end for
    m.parsers = []
    if isNode(m.persistence) and m.ownsPersistence then m.persistence.shutdown = true
end sub
