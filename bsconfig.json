{
  "rootDir": "src",
  "outDir": "dist",
  "files": [
    "source/**/*",
    "components/**/*"
  ],
  "compilerOptions": {
    "emitDefinitions": true,
    "sourceMap": false,
    "autoImportComponentScript": true
  },
  "diagnosticFilters": [
    { "src": "**/roku_modules/**/*", "codes": ["unnecessary-codebehind-script-import"] }
  ]
}
